<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="admin-wrapper">

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fa-solid fa-table-columns"></i>
            </div>
            <div>
                <div class="brand-name">Manager</div>
                <div class="brand-sub">Shop Management</div>
            </div>
        </div>

        <nav class="sidebar-nav">
             <a href="/Manager/Index"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "index" ? "active" : "")">
        <i class="fa-solid fa-chart-line nav-icon"></i>
        <span>Financial Dashboard</span>
    </a>

    <a href="/Manager/Inventory"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "inventory" ? "active" : "")">
        <i class="fa-solid fa-boxes-stacked nav-icon"></i>
        <span>Inventory</span>
    </a>

    <a href="/Manager/StockIn"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "stockin" ? "active" : "")">
        <i class="fa-solid fa-truck-ramp-box nav-icon"></i>
        <span>Stock In</span>
    </a>

    <a href="/Manager/ImportHistory"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "history" ? "active" : "")">
        <i class="fa-solid fa-clock-rotate-left nav-icon"></i>
        <span>History</span>
    </a>

    <a href="/Manager/Expenses"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "expenses" ? "active" : "")">
        <i class="fa-solid fa-money-bill-wave nav-icon"></i>
        <span>Expenses</span>
    </a>

    <a href="/Manager/Invoices"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "invoices" ? "active" : "")">
        <i class="fa-solid fa-file-invoice-dollar nav-icon"></i>
        <span>Invoices</span>
    </a>

    <a href="/Manager/RevenueReport"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "revenuereport" ? "active" : "")">
        <i class="fa-solid fa-sack-dollar nav-icon"></i>
        <span>Revenue Report</span>
    </a>

    <a href="/Manager/ProfitReport"
       class="nav-item @(ViewData["ActiveNav"]?.ToString() == "profitreport" ? "active" : "")">
        <i class="fa-solid fa-coins nav-icon"></i>
        <span>Profit Report</span>
    </a>

        </nav>

        <div class="sidebar-bottom">
            <a href="/Admin/InventoryCreate" class="btn-add-new">
                <i class="fa-solid fa-plus"></i>
                Add New Entry
            </a>
            <a href="#" class="sidebar-footer-link">
                <i class="fa-regular fa-circle-question"></i>
                <span>Help Center</span>
            </a>
            <a href="/Auth/Logout" class="sidebar-footer-link">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main area -->
    <div class="admin-main">

        <!-- Top header -->
        <header class="admin-header">
            <div class="header-search">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" placeholder="Search system..." class="search-input" />
            </div>
            <nav class="header-tabs">
                <a href="#" class="header-tab active">Overview</a>
                <a href="#" class="header-tab">History</a>
                <a href="#" class="header-tab">Reports</a>
            </nav>
            <div class="header-actions">
                <button class="header-icon-btn"><i class="fa-regular fa-bell"></i></button>
                <button class="header-icon-btn"><i class="fa-solid fa-grip"></i></button>
                <div class="header-avatar">I</div>
            </div>
        </header>

        <!-- Page content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
