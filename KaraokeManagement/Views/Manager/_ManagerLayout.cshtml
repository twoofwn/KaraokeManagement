@using System.Security.Claims
@{
	var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "User";
	var avatar = fullName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Manager</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	@RenderSection("Styles", required: false)
</head>
<body>
	<div class="admin-wrapper">

		<!-- Sidebar -->
		<aside class="admin-sidebar">
			<div class="sidebar-brand">
				<div class="brand-icon">
					<i class="fa-solid fa-briefcase"></i>
				</div>
				<div>
					<div class="brand-name">Minh Tuấn Karaoke</div>
					<div class="brand-sub">Quản lý</div>
				</div>
			</div>

			<nav class="sidebar-nav">
				<a href="/Manager/Index"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "index" ? "active" : "")">
					<i class="fa-solid fa-chart-line nav-icon"></i>
					<span>Báo cáo</span>
				</a>

				<a href="/Manager/Inventory"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "inventory" ? "active" : "")">
					<i class="fa-solid fa-boxes-stacked nav-icon"></i>
					<span>Kho hàng</span>
				</a>

				<a href="/Manager/StockIn"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "stockin" ? "active" : "")">
					<i class="fa-solid fa-truck-ramp-box nav-icon"></i>
					<span>Nhập hàng</span>
				</a>

				<a href="/Manager/ImportHistory"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "history" ? "active" : "")">
					<i class="fa-solid fa-clock-rotate-left nav-icon"></i>
					<span>Lịch sử nhập hàng</span>
				</a>

				<a href="/Manager/Expenses"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "expenses" ? "active" : "")">
					<i class="fa-solid fa-money-bill-wave nav-icon"></i>
					<span>Chi phí cố định</span>
				</a>

				<a href="/Manager/DynamicPricing"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "dynamicpricing" ? "active" : "")">
					<i class="fa-solid fa-tags nav-icon"></i>
					<span>Giá & Phụ thu</span>
				</a>

				<a href="/Manager/Invoices"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "invoices" ? "active" : "")">
					<i class="fa-solid fa-file-invoice-dollar nav-icon"></i>
					<span>Hóa đơn</span>
				</a>

				<a href="/Manager/RevenueReport"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "revenuereport" ? "active" : "")">
					<i class="fa-solid fa-sack-dollar nav-icon"></i>
					<span>Báo cáo doanh thu</span>
				</a>

				<a href="/Manager/ProfitReport"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "profitreport" ? "active" : "")">
					<i class="fa-solid fa-coins nav-icon"></i>
					<span>Báo cáo lợi nhuận</span>
				</a>

                <!-- HRM MODULE -->
                <div class="mt-3 mb-1 px-3 text-uppercase text-muted" style="font-size: 0.75rem; font-weight: 600;">HRM</div>

				<a href="/HRM/Employees"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "hrm_employees" ? "active" : "")">
					<i class="fa-solid fa-users nav-icon"></i>
					<span>Hồ sơ Nhân sự</span>
				</a>



				<a href="/ScheduleManagement/LeaveApprovals"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "leave_approvals" ? "active" : "")">
					<i class="fa-solid fa-user-xmark nav-icon"></i>
					<span>Duyệt nghỉ phép</span>
				</a>

				<a href="/ScheduleManagement/WeeklyGrid"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "weekly_grid" ? "active" : "")">
					<i class="fa-solid fa-calendar-week nav-icon"></i>
					<span>Lịch Lưới (Weekly Grid)</span>
				</a>

				<a href="/HRM/Attendance"
				   class="nav-item @(ViewData["ActiveNav"]?.ToString() == "hrm_attendance" ? "active" : "")">
					<i class="fa-solid fa-clock nav-icon"></i>
					<span>Chấm công</span>
				</a>

			</nav>

			<div class="sidebar-bottom">
				<a href="/Auth/Logout" class="sidebar-footer-link">
					<i class="fa-solid fa-arrow-right-from-bracket"></i>
					<span>Đăng xuất</span>
				</a>
			</div>
		</aside>

		<!-- Main area -->

		<div class="admin-main">

			<!-- Top header -->
			<header class="admin-header">
				<div@*  class="header-search" *@>
		</div>
		<nav class="header-tabs"></nav>
		<div class="header-actions">
			<div class="header-user">
				<span>@fullName</span>
			</div>
			<div class="header-avatar">@avatar</div>
		</div>
		</header>
		<!-- Page content -->
		<div class="admin-content">
			@RenderBody()
		</div>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
