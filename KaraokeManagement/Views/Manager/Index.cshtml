@model KaraokeManagement.ViewModel.FinancialDashboardViewModel

@{
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
    ViewData["Title"] = "Báo cáo quản lý";
    ViewData["ActiveNav"] = "index";
}

<style>
    /* Custom Soft UI Theme */
    :root {
        --brand-pink: #b60056;
        --brand-pink-hover: #960046;
        --card-bg: #f4f5f7;
        --text-main: #212529;
        --text-muted: #6c757d;
        --border-radius-lg: 20px;
        --border-radius-md: 12px;
    }

    .page-title {
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.2rem;
    }

    .soft-card {
        background-color: var(--card-bg);
        border-radius: var(--border-radius-lg);
        padding: 1.5rem;
        border: none;
        height: 100%;
    }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .stat-icon {
        width: 32px;
        height: 32px;
        background-color: #fce8f0;
        color: var(--brand-pink);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-icon.green {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .stat-icon.orange {
        background-color: #fff3e0;
        color: #ef6c00;
    }

    .stat-icon.blue {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .stat-sub {
        font-size: 0.8rem;
        font-weight: 600;
    }

    .text-green {
        color: #2e7d32 !important;
    }

    .text-red {
        color: #c62828 !important;
    }

    .chart-card {
        background-color: white;
        border: 1px solid #eaeaea;
        border-radius: var(--border-radius-lg);
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.01);
        height: 100%;
    }

    /* Tab Buttons Styling */
    .btn-tab-pill {
        border-radius: 30px;
        font-weight: 600;
        padding: 0.6rem 1.5rem;
        background-color: #f4f5f7;
        color: var(--text-main) !important;
        border: 1px solid #eaeaea;
        transition: all 0.2s ease;
    }
    .btn-tab-pill:hover {
        background-color: #eaeaea;
    }
    .btn-tab-pill.active {
        background-color: var(--brand-pink) !important;
        color: white !important;
        border-color: var(--brand-pink) !important;
    }

    .btn-outline-pink {
        border: 1px solid var(--brand-pink);
        color: var(--brand-pink);
        background: transparent;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.2s;
    }
    .btn-outline-pink:hover {
        background-color: var(--brand-pink);
        color: #fff;
    }
</style>

<div class="mb-4">
    <h2 class="page-title">Báo cáo tổng hợp</h2>
    <p class="text-muted mb-0">Quản lý báo cáo doanh thu, chi phí và lợi nhuận hoạt động kinh doanh Karaoke.</p>
</div>

<!-- Thống kê tổng quan hàng ngày/hàng tháng -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="soft-card">
            <div class="stat-header">
                <span>Số khách hôm nay</span>
                <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stat-value text-blue">@Model.CustomersToday</div>
            <div class="stat-sub text-muted">Từ booking trong ngày</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="soft-card">
            <div class="stat-header">
                <span>Doanh thu hôm nay</span>
                <div class="stat-icon green"><i class="fa-solid fa-money-bill-wave"></i></div>
            </div>
            <div class="stat-value text-green">@Model.RevenueToday.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">Hoá đơn đã thanh toán</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="soft-card">
            <div class="stat-header">
                <span>Số khách tháng này</span>
                <div class="stat-icon orange"><i class="fa-solid fa-users-rays"></i></div>
            </div>
            <div class="stat-value text-orange">@Model.CustomersThisMonth</div>
            <div class="stat-sub text-muted">Từ booking trong tháng</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="soft-card">
            <div class="stat-header">
                <span>Doanh thu tháng này</span>
                <div class="stat-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
            </div>
            <div class="stat-value text-pink">@Model.RevenueThisMonth.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">Hoá đơn đã thanh toán</div>
        </div>
    </div>
</div>

<!-- Tab Navigation Bar -->
<ul class="nav nav-pills mb-4 gap-2" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active btn-tab-pill" id="revenue-tab" data-bs-toggle="tab" data-bs-target="#revenue-content" type="button" role="tab" aria-controls="revenue-content" aria-selected="true">
            <i class="fa-solid fa-sack-dollar me-2"></i>Báo cáo Doanh thu
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link btn-tab-pill" id="profit-tab" data-bs-toggle="tab" data-bs-target="#profit-content" type="button" role="tab" aria-controls="profit-content" aria-selected="false">
            <i class="fa-solid fa-coins me-2"></i>Báo cáo Lợi nhuận & Chi phí
        </button>
    </li>
</ul>

<!-- Tab Content Panes -->
<div class="tab-content" id="dashboardTabContent">
    
    <!-- ================== TAB 1: REVENUE REPORT ================== -->
    <div class="tab-pane fade show active" id="revenue-content" role="tabpanel" aria-labelledby="revenue-tab">
        <!-- Thống kê doanh thu -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Tổng doanh thu</span>
                        <div class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                    </div>
                    <div class="stat-value" style="color: var(--brand-pink);">@Model.TotalRevenue.ToString("N0") ₫</div>
                    <div class="text-muted" style="font-size: 0.8rem; font-weight: 500;">Tổng doanh thu phòng hát & dịch vụ</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Doanh thu Tiền hát (Phòng)</span>
                        <div class="stat-icon" style="background-color: #e3f2fd; color: #1565c0;"><i class="fa-solid fa-microphone-lines"></i></div>
                    </div>
                    <div class="stat-value" style="color: #1565c0;">@Model.TotalRoomRevenue.ToString("N0") ₫</div>
                    <div class="text-muted" style="font-size: 0.8rem; font-weight: 500;">
                        Tỷ lệ: @(Model.TotalRevenue > 0 ? ((Model.TotalRoomRevenue / Model.TotalRevenue) * 100).ToString("F1") : "0")% tổng doanh thu
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Doanh thu Dịch vụ</span>
                        <div class="stat-icon" style="background-color: #e8f5e9; color: #2e7d32;"><i class="fa-solid fa-utensils"></i></div>
                    </div>
                    <div class="stat-value" style="color: #2e7d32;">@Model.TotalServiceRevenue.ToString("N0") ₫</div>
                    <div class="text-muted" style="font-size: 0.8rem; font-weight: 500;">
                        Tỷ lệ: @(Model.TotalRevenue > 0 ? ((Model.TotalServiceRevenue / Model.TotalRevenue) * 100).ToString("F1") : "0")% tổng doanh thu
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ phân tích doanh thu -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="chart-card">
                    <h5 class="fw-bold mb-4">Doanh thu theo Loại phòng</h5>
                    <div style="height: 300px; position: relative;">
                        <canvas id="roomTypeRevenueChart"></canvas>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-borderless align-middle" style="font-size: 0.85rem;">
                            <thead>
                                <tr class="text-muted">
                                    <th>Loại phòng</th>
                                    <th class="text-end">Doanh thu (VND)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.RoomTypeLabels.Count; i++)
                                {
                                    <tr>
                                        <td><strong>@Model.RoomTypeLabels[i]</strong></td>
                                        <td class="text-end fw-bold">@Model.RoomTypeRevenues[i].ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="chart-card">
                    <h5 class="fw-bold mb-4">Doanh thu theo Danh mục dịch vụ</h5>
                    <div style="height: 300px; position: relative;">
                        <canvas id="categoryRevenueChart"></canvas>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-borderless align-middle" style="font-size: 0.85rem;">
                            <thead>
                                <tr class="text-muted">
                                    <th>Danh mục</th>
                                    <th class="text-end">Doanh thu (VND)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.CategoryLabels.Count; i++)
                                {
                                    <tr>
                                        <td><strong>@Model.CategoryLabels[i]</strong></td>
                                        <td class="text-end fw-bold">@Model.CategoryRevenues[i].ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================== TAB 2: PROFIT REPORT ================== -->
    @{
        var totalRev12 = Model.ProfitItems.Sum(x => x.Revenue);
        var totalExp12 = Model.ProfitItems.Sum(x => x.Expenses);
        var netProf12 = totalRev12 - totalExp12;
        var avgMarg12 = totalRev12 > 0 ? (double)(netProf12 / totalRev12) * 100 : 0;
    }
    <div class="tab-pane fade" id="profit-content" role="tabpanel" aria-labelledby="profit-tab">
        <!-- Thống kê lợi nhuận 12 tháng qua -->
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Doanh thu (12 tháng qua)</span>
                        <div class="stat-icon" style="background-color: #e8f5e9; color: #2e7d32;"><i class="fa-solid fa-sack-dollar"></i></div>
                    </div>
                    <div class="stat-value text-green">@totalRev12.ToString("N0") ₫</div>
                    <div class="stat-sub text-muted">Doanh thu tích lũy</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Chi phí (12 tháng qua)</span>
                        <div class="stat-icon" style="background-color: #ffebee; color: #c62828;"><i class="fa-solid fa-wallet"></i></div>
                    </div>
                    <div class="stat-value text-red">@totalExp12.ToString("N0") ₫</div>
                    <div class="stat-sub text-muted">Chi phí & Đơn nhập hàng</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Lợi nhuận ròng (12T)</span>
                        <div class="stat-icon" style="background-color: #e3f2fd; color: #1565c0;"><i class="fa-solid fa-coins"></i></div>
                    </div>
                    <div class="stat-value @(netProf12 >= 0 ? "text-green" : "text-red")">@netProf12.ToString("N0") ₫</div>
                    <div class="stat-sub text-muted">Tổng chênh lệch lời/lỗ</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="soft-card">
                    <div class="stat-header">
                        <span>Biên lợi nhuận trung bình</span>
                        <div class="stat-icon"><i class="fa-solid fa-percent"></i></div>
                    </div>
                    <div class="stat-value text-pink">@avgMarg12.ToString("F1")%</div>
                    <div class="stat-sub text-muted">Tỷ suất lợi nhuận ròng</div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ lợi nhuận và doanh thu vs chi phí -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Xu hướng Doanh thu vs Chi phí (6 tháng qua)</h5>
                        <div class="d-flex gap-2">
                            <span class="badge" style="background-color: rgba(46, 125, 50, 0.1); color: #2e7d32; font-weight: 600; padding: 0.5rem 0.8rem; border-radius: 8px;">Doanh thu</span>
                            <span class="badge" style="background-color: rgba(198, 40, 40, 0.1); color: #c62828; font-weight: 600; padding: 0.5rem 0.8rem; border-radius: 8px;">Chi phí</span>
                        </div>
                    </div>
                    <div style="height: 300px; position: relative;">
                        <canvas id="financialTrendChart"></canvas>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="chart-card">
                    <h5 class="fw-bold mb-4">Lợi nhuận ròng hàng tháng (12 tháng qua)</h5>
                    <div style="height: 300px; position: relative;">
                        <canvas id="monthlyProfitChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng chi tiết Lời/Lỗ -->
        <div class="row">
            <div class="col-12">
                <div class="chart-card">
                    <h5 class="fw-bold mb-4">Bảng phân tích Lời/Lỗ theo tháng</h5>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle" style="font-size: 0.9rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Tháng</th>
                                    <th class="text-end">Doanh thu</th>
                                    <th class="text-end">Chi phí</th>
                                    <th class="text-end">Lợi nhuận</th>
                                    <th class="text-end">Biên LN</th>
                                    <th class="text-end" style="width: 15%;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ProfitItems)
                                {
                                    <tr>
                                        <td><strong>@item.MonthLabel</strong></td>
                                        <td class="text-end">@item.Revenue.ToString("N0") ₫</td>
                                        <td class="text-end text-red">@item.Expenses.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold @(item.NetProfit >= 0 ? "text-green" : "text-red")">
                                            @item.NetProfit.ToString("N0") ₫
                                        </td>
                                        <td class="text-end fw-semibold @(item.NetProfit >= 0 ? "text-green" : "text-red")">
                                            @item.Margin.ToString("F1")%
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-pink" onclick="showProfitDetail('@item.MonthLabel')">
                                                <i class="fa-solid fa-circle-info me-1"></i> Chi tiết
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Monthly Profit/Loss Breakdown Detail -->
<div class="modal fade" id="monthlyProfitDetailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-light border-0 py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold text-dark" id="detailModalLabel">
                    <i class="fa-solid fa-chart-pie text-pink me-2"></i>Chi Tiết Phân Tích Lời/Lỗ Theo Tháng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- SECTION A: EXPENSE BREAKDOWN -->
                    <div class="col-md-6 border-end">
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-5 fw-bold text-danger border-bottom pb-1 flex-grow-1"><i class="fa-solid fa-minus-circle me-1"></i>A. CHI PHÍ HOẠT ĐỘNG</span>
                        </div>
                        <div id="modalExpenseBody">
                            <!-- Dynamically loaded -->
                        </div>
                    </div>

                    <!-- SECTION B: REVENUE BREAKDOWN -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-5 fw-bold text-success border-bottom pb-1 flex-grow-1"><i class="fa-solid fa-plus-circle me-1"></i>B. DOANH THU ĐẠT ĐƯỢC</span>
                        </div>
                        <div id="modalRevenueBody">
                            <!-- Dynamically loaded -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light-subtle py-3">
                <button type="button" class="btn btn-secondary px-4 btn-sm" data-bs-dismiss="modal" style="border-radius: 6px;">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // ================== LINE CHART (Doanh thu vs Chi phí 6T) ==================
            const labels6 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
            const revenues6 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues));
            const expenses6 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses));

            const ctxTrend = document.getElementById('financialTrendChart').getContext('2d');
            new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: labels6,
                    datasets: [
                        {
                            label: 'Doanh thu',
                            data: revenues6,
                            borderColor: '#2e7d32',
                            backgroundColor: 'rgba(46, 125, 50, 0.05)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#2e7d32',
                            pointRadius: 5
                        },
                        {
                            label: 'Chi phí',
                            data: expenses6,
                            borderColor: '#c62828',
                            backgroundColor: 'rgba(198, 40, 40, 0.05)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#c62828',
                            pointRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return (value / 1000000).toLocaleString() + 'M ₫';
                                }
                            },
                            grid: { color: '#f3f3f3' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });

            // ================== BAR CHART (Room Type Revenue) ==================
            const roomLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoomTypeLabels));
            const roomData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoomTypeRevenues));
            
            const ctxRoom = document.getElementById('roomTypeRevenueChart').getContext('2d');
            new Chart(ctxRoom, {
                type: 'bar',
                data: {
                    labels: roomLabels,
                    datasets: [{
                        label: 'Doanh thu phòng',
                        data: roomData,
                        backgroundColor: '#1565c0',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return (value / 1000000).toLocaleString() + 'M ₫';
                                }
                            }
                        }
                    }
                }
            });

            // ================== DOUGHNUT CHART (Category Service Revenue) ==================
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues));

            const ctxCat = document.getElementById('categoryRevenueChart').getContext('2d');
            new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: [
                            '#e91e63', '#9c27b0', '#673ab7', '#3f51b5', '#009688', '#4caf50', '#ffeb3b', '#ff9800'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // ================== BAR CHART (Monthly Net Profit 12T) ==================
            const rawItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProfitItems));
            const profitLabels = rawItems.map(x => x.MonthLabel.replace("Tháng ", "T"));
            const profits = rawItems.map(x => x.NetProfit);
            
            const backgroundColors = profits.map(val => val >= 0 ? 'rgba(46, 125, 50, 0.7)' : 'rgba(198, 40, 40, 0.7)');
            const borderColors = profits.map(val => val >= 0 ? '#2e7d32' : '#c62828');

            const ctxProfit = document.getElementById('monthlyProfitChart').getContext('2d');
            new Chart(ctxProfit, {
                type: 'bar',
                data: {
                    labels: profitLabels,
                    datasets: [{
                        label: 'Lợi nhuận ròng',
                        data: profits,
                        backgroundColor: backgroundColors,
                        borderColor: borderColors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return (value / 1000000).toLocaleString() + 'M ₫';
                                }
                            }
                        }
                    }
                }
            });
        });

        function showProfitDetail(monthLabel) {
            const match = monthLabel.match(/Tháng\s+(\d+)\/(\d+)/i);
            if (!match) {
                alert("Nhãn tháng không hợp lệ: " + monthLabel);
                return;
            }
            const month = parseInt(match[1]);
            const year = parseInt(match[2]);

            document.getElementById('modalExpenseBody').innerHTML = `
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border text-pink spinner-border-sm mb-2" role="status"></div>
                    <div>Đang tải chi phí...</div>
                </div>
            `;
            document.getElementById('modalRevenueBody').innerHTML = `
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border text-pink spinner-border-sm mb-2" role="status"></div>
                    <div>Đang tải doanh thu...</div>
                </div>
            `;
            document.getElementById('detailModalLabel').innerHTML = `<i class="fa-solid fa-chart-pie text-pink me-2"></i>Chi Tiết Phân Tích Lời/Lỗ - ${monthLabel}`;
            
            const profitModal = new bootstrap.Modal(document.getElementById('monthlyProfitDetailModal'));
            profitModal.show();

            fetch(`/Manager/Index?handler=MonthlyProfitDetail&month=${month}&year=${year}`)
                .then(response => {
                    if (!response.ok) throw new Error('Không thể tải chi tiết phân tích tài chính');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('modalExpenseBody').innerHTML = `
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <span class="text-muted"><i class="fa-solid fa-boxes-stacked me-2 text-primary"></i>Chi phí hóa đơn / nhập hàng</span>
                                <span class="fw-bold text-dark">${formatCurrency(data.supplierExpenses)} ₫</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <span class="text-muted"><i class="fa-solid fa-user-tie me-2 text-info"></i>Tiền lương nhân viên</span>
                                <span class="fw-bold text-dark">${formatCurrency(data.staffPayroll)} ₫</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <span class="text-muted"><i class="fa-solid fa-credit-card me-2 text-warning"></i>Chi phí cố định theo tháng</span>
                                <span class="fw-bold text-dark">${formatCurrency(data.fixedExpenses)} ₫</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 bg-light mt-2 rounded">
                                <span class="fw-bold text-danger"><i class="fa-solid fa-wallet me-2"></i>Tổng chi phí cuối cùng</span>
                                <span class="fw-bold text-danger fs-5">${formatCurrency(data.totalExpense)} ₫</span>
                            </div>
                        </div>
                    `;

                    document.getElementById('modalRevenueBody').innerHTML = `
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <span class="text-muted"><i class="fa-solid fa-microphone-lines me-2 text-success"></i>Tiền phòng hát</span>
                                <span class="fw-bold text-dark">${formatCurrency(data.roomRevenue)} ₫</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <span class="text-muted"><i class="fa-solid fa-utensils me-2 text-danger"></i>Tiền dịch vụ / ăn uống</span>
                                <span class="fw-bold text-dark">${formatCurrency(data.serviceRevenue)} ₫</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 bg-light mt-2 rounded">
                                <span class="fw-bold text-success"><i class="fa-solid fa-money-bill-trend-up me-2"></i>Tổng doanh thu cuối cùng</span>
                                <span class="fw-bold text-success fs-5">${formatCurrency(data.totalRevenue)} ₫</span>
                            </div>
                        </div>
                    `;
                })
                .catch(error => {
                    document.getElementById('modalExpenseBody').innerHTML = `<div class="text-danger py-3 text-center">${error.message}</div>`;
                    document.getElementById('modalRevenueBody').innerHTML = `<div class="text-danger py-3 text-center">${error.message}</div>`;
                });
        }

        function formatCurrency(amount) {
            if (!amount) return '0';
            return amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }
    </script>
}