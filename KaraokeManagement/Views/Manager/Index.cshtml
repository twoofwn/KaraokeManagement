@model KaraokeManagement.ViewModel.FinancialDashboardViewModel

@{
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
    ViewData["Title"] = "Báo cáo quản lý";
    ViewData["ActiveNav"] = "index";
}

<style>
    /* Custom Soft UI Theme */
    :root {
        --brand-pink: #b60056;
        --brand-pink-hover: #960046;
        --card-bg: #f4f5f7;
        --text-main: #212529;
        --text-muted: #6c757d;
        --border-radius-lg: 20px;
        --border-radius-md: 12px;
    }

    .page-title {
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.2rem;
    }

    .soft-card {
        background-color: var(--card-bg);
        border-radius: var(--border-radius-lg);
        padding: 1.5rem;
        border: none;
        height: 100%;
    }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .stat-icon {
        width: 32px;
        height: 32px;
        background-color: #fce8f0;
        color: var(--brand-pink);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-icon.green {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .stat-icon.orange {
        background-color: #fff3e0;
        color: #ef6c00;
    }

    .stat-icon.blue {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .stat-sub {
        font-size: 0.8rem;
        font-weight: 600;
    }

    .text-green {
        color: #2e7d32 !important;
    }

    .text-red {
        color: #c62828 !important;
    }

    .chart-card {
        background-color: white;
        border: 1px solid #eaeaea;
        border-radius: var(--border-radius-lg);
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.01);
    }
</style>

<div class="mb-4">
    <h2 class="page-title">Dashboard</h2>
    <p class="text-muted mb-0">Tổng quan báo cáo doanh thu, chi phí và lợi nhuận hoạt động.</p>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Số khách hôm nay</span>
                <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stat-value text-blue">@Model.CustomersToday</div>
            <div class="stat-sub text-muted">Từ booking trong ngày</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Doanh thu hôm nay</span>
                <div class="stat-icon green"><i class="fa-solid fa-money-bill-wave"></i></div>
            </div>
            <div class="stat-value text-green">@Model.RevenueToday.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">Hoá đơn đã thanh toán</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Số khách tháng này</span>
                <div class="stat-icon orange"><i class="fa-solid fa-users-rays"></i></div>
            </div>
            <div class="stat-value text-orange">@Model.CustomersThisMonth</div>
            <div class="stat-sub text-muted">Từ booking trong tháng</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Doanh thu tháng này</span>
                <div class="stat-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
            </div>
            <div class="stat-value text-pink">@Model.RevenueThisMonth.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">Hoá đơn đã thanh toán</div>
        </div>
    </div>
</div>
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Tổng doanh thu</span>
                <div class="stat-icon green"><i class="fa-solid fa-sack-dollar"></i></div>
            </div>
            <div class="stat-value text-green">@Model.TotalRevenue.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">
                Từ hóa đơn đã thanh toán
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Tổng chi phí</span>
                <div class="stat-icon orange"><i class="fa-solid fa-wallet"></i></div>
            </div>
            <div class="stat-value text-red">@Model.TotalExpenses.ToString("N0") ₫</div>
            <div class="stat-sub text-muted">
                Chi phí & Đơn nhập hàng
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Lợi nhuận ròng</span>
                <div class="stat-icon blue"><i class="fa-solid fa-coins"></i></div>
            </div>
            <div class="stat-value @(Model.NetProfit >= 0 ? "text-green" : "text-red")">
                @Model.NetProfit.ToString("N0") ₫
            </div>
            <div class="stat-sub text-muted">
                Doanh thu trừ Chi phí
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="soft-card">
            <div class="stat-header">
                <span>Tỷ suất lợi nhuận</span>
                <div class="stat-icon"><i class="fa-solid fa-chart-pie"></i></div>
            </div>
            <div class="stat-value text-pink">@Model.ProfitMargin.ToString("F1")%</div>
            <div class="stat-sub text-muted">
                Hiệu quả kinh doanh
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ -->
<div class="row g-4">
    <div class="col-12">
        <div class="chart-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Xu hướng Doanh thu vs Chi phí (6 tháng qua)</h5>
                <div class="d-flex gap-2">
                    <span class="badge" style="background-color: rgba(46, 125, 50, 0.1); color: #2e7d32; font-weight: 600; padding: 0.5rem 0.8rem; border-radius: 8px;">Doanh thu</span>
                    <span class="badge" style="background-color: rgba(198, 40, 40, 0.1); color: #c62828; font-weight: 600; padding: 0.5rem 0.8rem; border-radius: 8px;">Chi phí</span>
                </div>
            </div>
            <div style="height: 400px; position: relative;">
                <canvas id="financialTrendChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Nhận dữ liệu từ Backend
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
            const revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues));
            const expenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses));

            // Khởi tạo biểu đồ đường so sánh Doanh thu vs Chi phí
            const ctx = document.getElementById('financialTrendChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh thu',
                            data: revenues,
                            borderColor: '#2e7d32',
                            backgroundColor: 'rgba(46, 125, 50, 0.05)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#2e7d32',
                            pointRadius: 5
                        },
                        {
                            label: 'Chi phí',
                            data: expenses,
                            borderColor: '#c62828',
                            backgroundColor: 'rgba(198, 40, 40, 0.05)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#c62828',
                            pointRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false // Ẩn legend mặc định vì đã tạo legend tùy chỉnh ở trên
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value, index, values) {
                                    return (value / 1000000).toLocaleString() + 'M ₫';
                                }
                            },
                            grid: {
                                color: '#f3f3f3'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        });
    </script>
}