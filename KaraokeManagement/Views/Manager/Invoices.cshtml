@model KaraokeManagement.ViewModel.ManagerInvoicesViewModel

@{
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
    ViewData["Title"] = "Quản lý hóa đơn";
    ViewData["ActiveNav"] = "invoices";
}

<style>
    /* Custom Theme & Colors cho Invoice Page */
    :root {
        --brand-pink: #b60056;
        --brand-pink-hover: #960046;
        --text-main: #212529;
        --text-muted: #6c757d;
        --bg-light-grey: #f5f6f8;
        --border-color: #eaeaea;
    }

    .text-pink {
        color: var(--brand-pink) !important;
    }

    /* Page Titles */
    .page-title {
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--text-main);
        margin-bottom: 0.2rem;
    }

    /* Main Table Card */
    .invoice-card {
        background-color: var(--bg-light-grey);
        border-radius: 12px;
        padding: 1.25rem 1.25rem 0.75rem 1.25rem;
        border: 1px solid var(--border-color);
    }

    /* Table Styles */
    .table-invoice {
        margin-bottom: 1.5rem;
    }

    .table-invoice th {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.85rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 0.75rem;
        padding-top: 0.25rem;
        background: transparent;
    }

    .table-invoice td {
        vertical-align: middle;
        padding: 0.75rem 0.5rem;
        border-bottom: none;
        background: transparent;
    }

    .invoice-id {
        color: var(--brand-pink);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .date-text {
        color: var(--text-main);
        font-size: 0.9rem;
    }

    .currency-val {
        font-size: 0.95rem;
        color: var(--text-main);
    }

    .currency-symbol {
        font-size: 0.8rem;
        font-weight: normal;
        margin-left: 2px;
    }

    .total-val {
        font-size: 1rem;
        font-weight: 700;
    }

    /* Badges */
    .badge-custom {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.4rem 0.8rem;
        border-radius: 30px;
        display: inline-block;
    }
    .badge-paid {
        background-color: rgba(46, 125, 50, 0.1);
        color: #2e7d32;
        border: 1px solid rgba(46, 125, 50, 0.2);
    }
    .badge-unpaid {
        background-color: rgba(239, 108, 0, 0.1);
        color: #ef6c00;
        border: 1px solid rgba(239, 108, 0, 0.2);
    }

    /* Pagination */
    .pagination-wrapper {
        border-top: 1px solid var(--border-color);
        padding-top: 1.5rem;
    }

    .pagination-custom {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 5px;
        align-items: center;
    }

    .pagination-custom li a,
    .pagination-custom li span {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        text-decoration: none;
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 500;
        transition: 0.2s;
        border: none;
        background: transparent;
    }

    .pagination-custom li a:hover {
        background-color: #e9ecef;
    }

    .pagination-custom li.active a {
        background-color: var(--brand-pink);
        color: white;
    }

    .pagination-custom li.disabled span,
    .pagination-custom li.disabled a {
        color: var(--text-muted);
        pointer-events: none;
        opacity: 0.5;
    }

    .pagination-info {
        font-size: 0.85rem;
        color: var(--text-muted);
    }
</style>

<div class="mb-4">
    <h1 class="page-title">Quản lý hóa đơn</h1>
    <p class="text-muted mb-0">Tra cứu, tìm kiếm và lọc danh sách hóa đơn của các phòng hát.</p>
</div>

<!-- STICKY FILTER BAR -->
<form method="get" action="/Manager/Invoices" class="row g-3 mb-4 align-items-end filter-bar sticky-top shadow-sm py-3 px-4 bg-white border border-light" style="border-radius: 12px; top: 10px; z-index: 99;">
    <div class="col-md-3">
        <label for="searchInvoiceId" class="form-label fw-bold text-muted mb-1" style="font-size: 0.85rem;">Mã hóa đơn</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <input type="text" name="searchInvoiceId" id="searchInvoiceId" class="form-control bg-light border-0" placeholder="Nhập mã hóa đơn (e.g. 10023)" value="@Model.SearchInvoiceId" />
        </div>
    </div>
    
    <div class="col-md-2">
        <label for="searchDate" class="form-label fw-bold text-muted mb-1" style="font-size: 0.85rem;">Ngày tạo cụ thể</label>
        <input type="date" name="searchDate" id="searchDate" class="form-control bg-light border-0" value="@Model.SearchDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label for="roomId" class="form-label fw-bold text-muted mb-1" style="font-size: 0.85rem;">Phòng hát</label>
        <select name="roomId" id="roomId" class="form-select bg-light border-0">
            <option value="">-- Tất cả phòng --</option>
            @foreach (var room in Model.Rooms)
            {
                if (Model.SelectedRoomId == room.RoomId)
                {
                    <option value="@room.RoomId" selected="selected">@room.RoomName</option>
                }
                else
                {
                    <option value="@room.RoomId">@room.RoomName</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.85rem;">Khoảng thời gian tạo (Khi không tìm theo ngày cụ thể)</label>
        <div class="d-flex gap-2 align-items-center">
            <input type="date" name="fromDate" id="fromDate" class="form-control bg-light border-0" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            <span class="text-muted" style="font-size: 0.85rem;">đến</span>
            <input type="date" name="toDate" id="toDate" class="form-control bg-light border-0" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="col-md-1 d-flex gap-2">
        <button type="submit" class="btn w-100 py-2 fw-semibold" style="background-color: var(--brand-pink); color: white; border-radius: 8px; border: none; font-size: 0.9rem;">
            <i class="fa-solid fa-filter me-1"></i> Lọc
        </button>
        <a href="/Manager/Invoices" class="btn btn-outline-secondary py-2" style="border-radius: 8px;" title="Reset bộ lọc">
            <i class="fa-solid fa-arrows-rotate"></i>
        </a>
    </div>
</form>

<div class="invoice-card">
    <div class="table-responsive">
        <table class="table table-borderless table-invoice table-hover">
            <thead>
                <tr>
                    <th width="15%">Mã hóa đơn</th>
                    <th width="15%">Phòng hát</th>
                    <th width="20%">Khách hàng</th>
                    <th width="20%">Ngày tạo</th>
                    <th width="15%">Trạng thái</th>
                    <th width="15%" class="text-end">Tổng tiền</th>
                    <th width="10%" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Invoices == null || !Model.Invoices.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy hóa đơn nào phù hợp với bộ lọc.</td>
                    </tr>
                }
                else
                {
                    foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td>
                                <div class="invoice-id">#INV-@inv.InvoiceId</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@inv.Room.RoomName</div>
                            </td>
                            <td>
                                <div class="text-dark">@(inv.Booking?.Customer?.FullName ?? "Khách lẻ")</div>
                            </td>
                            <td>
                                <div class="date-text">
                                    @inv.CheckInTime.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                @if (inv.Status == "Paid")
                                {
                                    <span class="badge-custom badge-paid">Paid</span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-unpaid">Unpaid</span>
                                }
                            </td>
                            <td>
                                <div class="currency-val total-val text-pink fw-bold text-end">
                                    @((inv.GrandTotal ?? 0).ToString("N0")) <span class="currency-symbol">₫</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-outline-pink btn-sm view-invoice-btn px-3" data-id="@inv.InvoiceId" style="border-color: var(--brand-pink); color: var(--brand-pink); border-radius: 6px;">
                                    <i class="fa-regular fa-eye me-1"></i> Xem chi tiết
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="pagination-wrapper d-flex justify-content-between align-items-center flex-wrap">
        <div class="pagination-info">
            Hiển thị @Model.StartEntry đến @Model.EndEntry trong tổng số @Model.TotalCount bản ghi
        </div>
        <ul class="pagination-custom">
            <!-- Nút Trước -->
            <li class="@(Model.CurrentPage == 1 ? "disabled" : "")">
                <a href="/Manager/Invoices?searchInvoiceId=@Model.SearchInvoiceId&searchDate=@Model.SearchDate?.ToString("yyyy-MM-dd")&roomId=@Model.SelectedRoomId&fromDate=@Model.FromDate.ToString("yyyy-MM-dd")&toDate=@Model.ToDate.ToString("yyyy-MM-dd")&page=@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i>
                </a>
            </li>

            <!-- Các số trang -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="@(Model.CurrentPage == i ? "active" : "")">
                    <a href="/Manager/Invoices?searchInvoiceId=@Model.SearchInvoiceId&searchDate=@Model.SearchDate?.ToString("yyyy-MM-dd")&roomId=@Model.SelectedRoomId&fromDate=@Model.FromDate.ToString("yyyy-MM-dd")&toDate=@Model.ToDate.ToString("yyyy-MM-dd")&page=@i">@i</a>
                </li>
            }

            <!-- Nút Sau -->
            <li class="@(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a href="/Manager/Invoices?searchInvoiceId=@Model.SearchInvoiceId&searchDate=@Model.SearchDate?.ToString("yyyy-MM-dd")&roomId=@Model.SelectedRoomId&fromDate=@Model.FromDate.ToString("yyyy-MM-dd")&toDate=@Model.ToDate.ToString("yyyy-MM-dd")&page=@(Model.CurrentPage + 1)">
                    <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- INVOICE DETAILS MODAL -->
<div class="modal fade" id="invoiceDetailModal" tabindex="-1" aria-labelledby="invoiceDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <div class="modal-header" style="background-color: var(--brand-pink); color: white; padding: 1.2rem 1.5rem;">
                <h5 class="modal-title fw-bold" id="invoiceDetailModalLabel">Chi tiết Hóa đơn <span id="modalInvoiceId"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <!-- Info Rows -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold text-pink mb-3"><i class="fa-solid fa-microphone-lines me-2"></i>Thông tin phòng</h6>
                        <div class="mb-2"><strong>Phòng:</strong> <span id="modalRoomName"></span></div>
                        <div class="mb-2"><strong>Loại phòng:</strong> <span id="modalRoomType"></span></div>
                        <div class="mb-2"><strong>Đơn giá/Giờ:</strong> <span id="modalPricePerHour"></span> ₫</div>
                        <div class="mb-2"><strong>Thời gian hát:</strong> <span id="modalDurationText"></span></div>
                        <div class="mb-2"><small class="text-muted">Nhận: <span id="modalCheckIn"></span> | Trả: <span id="modalCheckOut"></span></small></div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-pink mb-3"><i class="fa-solid fa-user me-2"></i>Khách hàng & Phục vụ</h6>
                        <div class="mb-2"><strong>Khách hàng:</strong> <span id="modalCustomerName"></span></div>
                        <div class="mb-2"><strong>Số điện thoại:</strong> <span id="modalCustomerPhone"></span></div>
                        <div class="mb-2"><strong>Hạng thành viên:</strong> <span id="modalCustomerTier"></span></div>
                        <div class="mb-2"><strong>Nhân viên phục vụ:</strong> <span id="modalStaffNames" class="fw-semibold text-dark"></span></div>
                        <div class="mb-2"><strong>Thu ngân thanh toán:</strong> <span id="modalReceptionistName"></span></div>
                    </div>
                </div>

                <!-- Services Table -->
                <h6 class="fw-bold text-pink mb-3"><i class="fa-solid fa-utensils me-2"></i>Dịch vụ đã sử dụng</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-striped table-hover align-middle" style="font-size: 0.9rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Tên dịch vụ</th>
                                <th>ĐVT</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá (VND)</th>
                                <th class="text-end">Thành tiền (VND)</th>
                            </tr>
                        </thead>
                        <tbody id="modalServicesBody">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>

                <!-- Payment Transactions -->
                <div id="modalPaymentSection" class="mb-4">
                    <h6 class="fw-bold text-pink mb-2"><i class="fa-solid fa-wallet me-2"></i>Phương thức thanh toán</h6>
                    <div class="bg-light p-3 rounded" style="font-size: 0.85rem;" id="modalPaymentDetails">
                        <!-- Dynamic Content -->
                    </div>
                </div>

                <!-- Financial Breakdown -->
                <div class="row justify-content-end">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền giờ phòng:</span>
                            <span class="fw-semibold" id="modalRoomTotal"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền dịch vụ:</span>
                            <span class="fw-semibold" id="modalServiceTotal"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Khấu trừ giảm giá:</span>
                            <span class="fw-semibold text-danger" id="modalDiscountAmount"></span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Tổng cộng thanh toán:</span>
                            <span class="fw-bold text-pink fs-4" id="modalGrandTotal"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background-color: var(--bg-light-grey); border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Click Handler for View Invoice Details
            const viewButtons = document.querySelectorAll('.view-invoice-btn');
            viewButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const invoiceId = this.getAttribute('data-id');
                    
                    $.ajax({
                        url: '/Manager/InvoiceDetails?id=' + invoiceId,
                        type: 'GET',
                        success: function(response) {
                            if (response.success) {
                                const data = response.data;
                                
                                // Set basic info
                                document.getElementById('modalInvoiceId').innerText = '#INV-' + data.invoiceId;
                                document.getElementById('modalRoomName').innerText = data.roomName;
                                document.getElementById('modalRoomType').innerText = data.roomTypeName;
                                document.getElementById('modalPricePerHour').innerText = parseFloat(data.pricePerHour).toLocaleString();
                                document.getElementById('modalDurationText').innerText = data.durationText;
                                document.getElementById('modalCheckIn').innerText = data.checkInTime;
                                document.getElementById('modalCheckOut').innerText = data.checkOutTime;
                                
                                document.getElementById('modalCustomerName').innerText = data.customerName;
                                document.getElementById('modalCustomerPhone').innerText = data.customerPhone;
                                document.getElementById('modalCustomerTier').innerText = data.customerTier + ' (' + data.discountPercent + '% giảm giá)';
                                document.getElementById('modalStaffNames').innerText = data.staffNames;
                                document.getElementById('modalReceptionistName').innerText = data.receptionistName;

                                // Set subtotals
                                document.getElementById('modalRoomTotal').innerText = parseFloat(data.roomTotal).toLocaleString() + ' ₫';
                                document.getElementById('modalServiceTotal').innerText = parseFloat(data.serviceTotal).toLocaleString() + ' ₫';
                                document.getElementById('modalDiscountAmount').innerText = '-' + parseFloat(data.discountAmount).toLocaleString() + ' ₫';
                                document.getElementById('modalGrandTotal').innerText = parseFloat(data.grandTotal).toLocaleString() + ' ₫';

                                // Render services
                                const servicesBody = document.getElementById('modalServicesBody');
                                servicesBody.innerHTML = '';
                                if (data.items.length === 0) {
                                    servicesBody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Không sử dụng dịch vụ nào.</td></tr>';
                                } else {
                                    data.items.forEach(item => {
                                        servicesBody.innerHTML += `
                                            <tr>
                                                <td>${item.serviceName}</td>
                                                <td>${item.unit || 'Chưa rõ'}</td>
                                                <td class="text-center">${item.quantity}</td>
                                                <td class="text-end">${parseFloat(item.unitPrice).toLocaleString()}</td>
                                                <td class="text-end fw-bold">${parseFloat(item.total).toLocaleString()}</td>
                                            </tr>
                                        `;
                                    });
                                }

                                // Render payment info
                                const paymentDetails = document.getElementById('modalPaymentDetails');
                                paymentDetails.innerHTML = '';
                                if (data.payments.length === 0) {
                                    paymentDetails.innerHTML = 'Chưa ghi nhận giao dịch thanh toán.';
                                } else {
                                    data.payments.forEach(pay => {
                                        let refInfo = pay.refCode ? ` (Mã GD: <strong>${pay.refCode}</strong>)` : '';
                                        paymentDetails.innerHTML += `
                                            <div class="mb-1">
                                                - Phương thức: <strong>${pay.methodName}</strong> | Số tiền: <strong>${parseFloat(pay.amount).toLocaleString()} ₫</strong> | Lúc: ${pay.date}${refInfo}
                                            </div>
                                        `;
                                    });
                                }

                                // Show Modal
                                var myModal = new bootstrap.Modal(document.getElementById('invoiceDetailModal'));
                                myModal.show();
                            } else {
                                alert('Không thể lấy chi tiết hóa đơn: ' + response.message);
                            }
                        },
                        error: function(xhr, status, error) {
                            alert('Đã xảy ra lỗi khi lấy dữ liệu hóa đơn.');
                            console.error(error);
                        }
                    });
                });
            });
        });
    </script>
}
