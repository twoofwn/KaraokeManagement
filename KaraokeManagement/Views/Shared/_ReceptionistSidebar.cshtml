@{
    var currentPath = Context.Request.Path.Value ?? "";
    var isRoomMapActive = currentPath.Contains("/Receptionist/Index") || currentPath.EndsWith("/Receptionist") || currentPath.EndsWith("/Receptionist/") || currentPath.Contains("/Receptionist/Checkout") || currentPath.Contains("/Receptionist/Detail");
    var isCheckInActive = currentPath.Contains("/Receptionist/CheckIn");
    var isListBookingActive = currentPath.Contains("/Receptionist/ListBooking");
    var isCheckInActive1 = currentPath.Contains("/Receptionist/BookingConfirm") || currentPath.Contains("/Receptionist/BookingConfirmDetail");
    var isInvoiceHistoryActive = currentPath.Contains("/Receptionist/InvoiceHistory");
}
<aside class="reception-sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">
            <i class="fa-solid fa-bell-concierge"></i>
        </div>
        <div>
            <div class="logo-main">Minh Tuấn Karaoke</div>
            <div class="logo-sub">Lễ tân</div>
        </div>
    </div>

    <ul class="sidebar-menu">
        <li class="menu-item @(isRoomMapActive ? "active" : "")">
            <a href="/Receptionist/Index">
                <i class="fa-solid fa-shapes"></i>
                <span>Quản lý phòng</span>
            </a>
        </li>

        <li class="menu-item @(isCheckInActive ? "active" : "")">
            <a href="/Receptionist/CheckIn">
                <i class="fa-solid fa-file-signature"></i>
                <span>Check-in</span>
            </a>

        </li>
        <li class="menu-item @(isListBookingActive ? "active" : "")">
            <a href="/Receptionist/ListBooking">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Danh sách đặt phòng</span>
            </a>
        </li>

        <li class="menu-item @(isCheckInActive1 ? "active" : "")">
            <a href="/Receptionist/BookingConfirm">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Xác nhận đặt phòng</span>
            </a>
        </li>

        <li class="menu-item @(isInvoiceHistoryActive ? "active" : "")">
            <a href="/Receptionist/InvoiceHistory">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>Lịch sử hóa đơn</span>
            </a>
        </li>
        <li class="menu-item @(currentPath.Contains("/Receptionist/Schedule") ? "active" : "")">
            <a href="/Receptionist/Schedule">
                <i class="fa-solid fa-calendar-week"></i>
                <span>Lịch làm việc</span>
            </a>
        </li>
        <li class="menu-item @(currentPath.Contains("/Receptionist/SwapRequests") ? "active" : "")">
            <a href="/Receptionist/SwapRequests">
                <i class="fa-solid fa-right-left"></i>
                <span>Yêu cầu đổi ca</span>
            </a>
        </li>
        <li class="menu-item @(currentPath.Contains("/Receptionist/LeaveRequest") ? "active" : "")">
            <a href="/Receptionist/LeaveRequest">
                <i class="fa-solid fa-calendar-minus"></i>
                <span>Xin nghỉ phép</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-footer">
        <a href="/Auth/Logout" class="logout-link">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span>Đăng xuất</span>
        </a>
    </div>
</aside>