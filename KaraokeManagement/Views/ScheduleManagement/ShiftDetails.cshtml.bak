@using KaraokeManagement.Models
@{
    ViewData["Title"] = "Shift Detail List";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";

    var shiftObj = ViewData["Shift"] as WorkShift;
    var workDateVal = (DateOnly)(ViewData["WorkDate"] ?? new DateOnly(2026, 7, 21));
    var dbSchedulesList = ViewData["Schedules"] as List<EmployeeSchedule> ?? new List<EmployeeSchedule>();
    var dbProfilesList = ViewData["Profiles"] as List<EmployeeProfile> ?? new List<EmployeeProfile>();

    string shiftTitleStr = shiftObj != null 
        ? $"{shiftObj.ShiftName} Shift ({shiftObj.StartTime} - {shiftObj.EndTime}) — {workDateVal:yyyy-MM-dd}"
        : $"Ca Làm Việc — {workDateVal:yyyy-MM-dd}";
}

<style>
    .bg-orange {
        background-color: #fd7e14 !important;
        color: #ffffff !important;
    }
    .btn-orange {
        background-color: #fd7e14 !important;
        border-color: #fd7e14 !important;
        color: #ffffff !important;
        font-weight: 500;
    }
    .btn-orange:hover {
        background-color: #e66a00 !important;
        color: #ffffff !important;
    }
    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #e9ecef;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }
</style>

<!-- Top Left Back Link -->
<div class="mb-3">
    <a href="/ScheduleManagement/WeeklyGrid" class="text-decoration-none text-secondary fw-medium">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Schedule Grid
    </a>
</div>

<!-- Title -->
<h3 class="fw-bold mb-4">
    @shiftTitleStr
</h3>

<!-- Toolbar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 600px;">
        <select class="form-select" id="roleFilter" style="width: 180px;" onchange="applyFilter()">
            <option value="All">All Roles</option>
            <option value="Receptionist">Receptionist</option>
            <option value="Manager">Manager</option>
            <option value="Admin">Admin</option>
        </select>
        <input type="text" class="form-control" id="searchInput" placeholder="Search staff name or email..." onkeyup="applyFilter()" />
        <button class="btn btn-orange px-4" onclick="applyFilter()"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</button>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-orange" onclick="window.location.href='/ScheduleManagement/Index'"><i class="fa-solid fa-circle-check me-1"></i> Schedule Status</button>
        <button class="btn btn-orange" onclick="window.location.href='/HRM/Schedules'"><i class="fa-solid fa-user-plus me-1"></i> Add Staff to this Shift</button>
    </div>
</div>

<!-- The Data Table -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="bg-orange text-white">
                    <th class="py-3 px-4" style="width: 30%;">Staff</th>
                    <th class="py-3" style="width: 20%;">Citizen ID</th>
                    <th class="py-3" style="width: 20%;">Phone</th>
                    <th class="py-3" style="width: 15%;">Role</th>
                    <th class="py-3 text-center" style="width: 15%;">Status</th>
                </tr>
            </thead>
            <tbody id="staffTableBody" class="bg-white">
                <!-- Javascript will populate rows from real DB data -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const dbStaffData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dbSchedulesList.Select(s => {
            var prof = dbProfilesList.FirstOrDefault(p => p.AccountId == s.AccountId);
            return new {
                name = s.Account.FullName,
                email = s.Account.Email ?? $"{s.Account.Username}@gmail.com",
                citizenId = prof?.IdentityCardNumber ?? "N/A",
                phone = s.Account.Phone ?? "N/A",
                role = s.Account.Role.RoleName,
                status = s.Status ?? "Scheduled"
            };
        })));

        function renderStaffTable(data) {
            const tbody = document.getElementById("staffTableBody");
            tbody.innerHTML = "";

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">Chưa có nhân sự nào được phân vào ca làm việc này.</td></tr>`;
                return;
            }

            data.forEach(staff => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="px-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">${staff.name}</div>
                                <div class="text-muted small">${staff.email}</div>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-secondary font-monospace">${staff.citizenId}</td>
                    <td class="py-3 text-secondary">${staff.phone}</td>
                    <td class="py-3"><span class="badge bg-light text-dark border px-2 py-1">${staff.role}</span></td>
                    <td class="py-3 text-center"><span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1">${staff.status}</span></td>
                </tr>`;
                tbody.appendChild(tr);
            });
        }

        function applyFilter() {
            const role = document.getElementById("roleFilter").value;
            const search = document.getElementById("searchInput").value.toLowerCase().trim();

            const filtered = dbStaffData.filter(s => {
                const matchRole = (role === "All" || s.role === role);
                const matchSearch = s.name.toLowerCase().includes(search) || s.email.toLowerCase().includes(search);
                return matchRole && matchSearch;
            });

            renderStaffTable(filtered);
        }

        document.addEventListener("DOMContentLoaded", () => renderStaffTable(dbStaffData));
    </script>
}
