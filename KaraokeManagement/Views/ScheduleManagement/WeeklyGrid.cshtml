@using KaraokeManagement.Models
@{
    ViewData["Title"] = "Schedule Management";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";

    var startOfWeek = (DateTime)(ViewData["StartOfWeek"] ?? new DateTime(2026, 7, 20));
    var endOfWeek = (DateTime)(ViewData["EndOfWeek"] ?? new DateTime(2026, 7, 26));
    var dbShifts = ViewData["Shifts"] as List<WorkShift> ?? new List<WorkShift>();
    var dbSchedules = ViewData["RawSchedules"] as List<EmployeeSchedule> ?? new List<EmployeeSchedule>();
}

<style>
    .bg-brand-header {
        background-color: var(--brand-deep-purple) !important;
        color: #ffffff !important;
    }
    .badge-receptionist {
        background-color: #fef9c3 !important;
        color: #854d0e !important;
        border: 1px solid #fef08a;
    }
    .badge-manager {
        background-color: #e0f2fe !important;
        color: #0369a1 !important;
        border: 1px solid #bae6fd;
    }
    .badge-admin {
        background-color: #ffe4e6 !important;
        color: #9f1239 !important;
        border: 1px solid #fecdd3;
    }
    .grid-cell {
        position: relative;
        min-height: 120px;
        cursor: pointer;
        transition: background-color 0.2s;
        border-color: var(--brand-light-pink) !important;
    }
    .grid-cell:hover {
        background-color: var(--brand-cream) !important;
    }
    .btn-add-cell {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 22px;
        height: 22px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        border-radius: 4px;
        border-color: var(--brand-light-pink);
        color: var(--brand-deep-purple);
    }
    .btn-add-cell:hover {
        background-color: var(--brand-light-pink);
        color: var(--brand-deep-purple);
    }
</style>

<!-- Header & Controls -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <h2 class="fw-bold mb-0 text-brand-deep-purple">Lịch Làm Việc Tuần</h2>
    
    <!-- Left Controls -->
    <div class="d-flex align-items-center gap-2 shadow-sm p-1 bg-white rounded border">
        <a href="/ScheduleManagement/WeeklyGrid?startDate=@startOfWeek.AddDays(-7).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm border-0"><i class="fa-solid fa-chevron-left"></i></a>
        <select class="form-select form-select-sm fw-medium border-0" style="width: auto; background-color: transparent;" onchange="window.location.href='/ScheduleManagement/WeeklyGrid?startDate='+this.value">
            <option value="@startOfWeek.ToString("yyyy-MM-dd")" selected>@startOfWeek.ToString("dd/MM/yyyy") -> @endOfWeek.ToString("dd/MM/yyyy") (Tuần này)</option>
            <option value="@startOfWeek.AddDays(-7).ToString("yyyy-MM-dd")">@startOfWeek.AddDays(-7).ToString("dd/MM/yyyy") -> @startOfWeek.AddDays(-1).ToString("dd/MM/yyyy")</option>
            <option value="@startOfWeek.AddDays(7).ToString("yyyy-MM-dd")">@startOfWeek.AddDays(7).ToString("dd/MM/yyyy") -> @startOfWeek.AddDays(13).ToString("dd/MM/yyyy")</option>
        </select>
        <a href="/ScheduleManagement/WeeklyGrid?startDate=@startOfWeek.AddDays(7).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm border-0"><i class="fa-solid fa-chevron-right"></i></a>
    </div>

    <!-- Right Controls -->
    <div class="d-flex gap-2">
        <button class="btn btn-brand-secondary text-nowrap" onclick="runAutoSchedule('@startOfWeek.ToString("yyyy-MM-dd")')">
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Tự Động Xếp Lịch
        </button>
        <a href="/ScheduleManagement/Schedules?date=@startOfWeek.ToString("yyyy-MM-dd")" class="btn btn-brand-primary text-nowrap">
            <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa lịch làm
        </a>
    </div>
</div>

<!-- The Schedule Grid -->
<div class="shadow-sm overflow-hidden p-1 bg-white border rounded">
    <div class="table-responsive rounded">
        <table class="table table-bordered mb-0 align-middle">
            <thead>
                <tr class="text-center">
                    <th style="width: 14%;" class="py-3 schedule-table-header-pink">Ca làm việc</th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var dayDate = startOfWeek.AddDays(i);
                        string[] dayNames = { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ Nhật" };
                        <th style="width: 12.2%;" class="py-3 schedule-table-header-pink">@dayNames[i] @dayDate.Day/@dayDate.Month</th>
                    }
                </tr>
            </thead>
            <tbody id="gridTbody" style="background-color: #FFFFFF;">
                <!-- JavaScript renders real database schedules -->
            </tbody>
        </table>
    </div>
</div>

<!-- SHIFT DETAILS MODAL -->
<div class="modal fade" id="shiftDetailsModal" tabindex="-1" aria-labelledby="shiftDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <div class="modal-header text-white" style="background-color: var(--brand-pink); padding: 1.2rem 1.5rem;">
                <h5 class="modal-title fw-bold" id="shiftDetailsModalLabel">Chi tiết Ca làm việc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem 2rem;">
                <!-- Header Info -->
                <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded" style="background-color: var(--bg-light-grey); border: 1px solid var(--border-color);">
                    <div>
                        <h6 class="fw-bold mb-1 text-pink fs-5" id="modalShiftName">Ca làm việc</h6>
                        <div class="text-muted small"><i class="fa-regular fa-clock me-1"></i> Giờ làm: <span id="modalShiftTime">00:00 - 00:00</span></div>
                    </div>
                    <div class="text-end">
                        <span class="badge text-white fw-bold px-3 py-2" id="modalShiftDate" style="background-color: var(--brand-pink); border-radius: 30px; font-size: 0.9rem;">01/01/2026</span>
                    </div>
                </div>

                <!-- Filters -->
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <select class="form-select form-select-sm" id="modalRoleFilter" style="border-radius: 6px;">
                            <option value="All">Tất cả chức vụ</option>
                            <option value="Receptionist">Receptionist</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <input type="text" class="form-control form-control-sm" id="modalSearchInput" placeholder="Tìm tên hoặc email nhân viên..." style="border-radius: 6px;">
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive rounded border">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="text-white" style="background-color: var(--brand-pink);">
                            <tr>
                                <th class="py-2 px-3" style="font-weight: 500;">Nhân viên</th>
                                <th class="py-2" style="font-weight: 500;">CCCD</th>
                                <th class="py-2" style="font-weight: 500;">Số điện thoại</th>
                                <th class="py-2" style="font-weight: 500;">Chức vụ</th>
                                <th class="py-2 text-center" style="font-weight: 500;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="modalStaffTableBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="background-color: var(--bg-light-grey); border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary px-4 btn-sm" style="border-radius: 6px;" data-bs-dismiss="modal">Đóng</button>
                <a href="/ScheduleManagement/Schedules" id="modalEditScheduleBtn" class="btn btn-brand-primary px-4 btn-sm" style="border-radius: 6px;"><i class="fa-solid fa-pen-to-square me-1"></i>Chỉnh sửa lịch</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const dbShifts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dbShifts.Select(s => new {
            id = s.ShiftId,
            name = s.ShiftName,
            timeRange = $"{s.StartTime} - {s.EndTime}"
        })));

        const dbSchedulesRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dbSchedules.Select(s => new {
            shiftId = s.ShiftId,
            workDate = s.WorkDate.ToString("yyyy-MM-dd"),
            roleName = s.Account.Role.RoleName,
            accountName = s.Account.FullName,
            status = s.Status
        })));

        const days = [
            "@startOfWeek.ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(1).ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(2).ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(3).ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(4).ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(5).ToString("yyyy-MM-dd")",
            "@startOfWeek.AddDays(6).ToString("yyyy-MM-dd")"
        ];

        function getRoleBadgeClass(roleName) {
            if (roleName.includes("Receptionist") || roleName.includes("Lễ tân")) return "badge-receptionist";
            if (roleName.includes("Manager") || roleName.includes("Quản lý")) return "badge-manager";
            if (roleName.includes("Admin") || roleName.includes("Quản trị")) return "badge-admin";
            return "bg-light text-dark border";
        }

        let activeShiftStaffData = [];

        function showShiftDetails(shiftId, dateStr) {
            $.ajax({
                url: `/ScheduleManagement/ShiftDetails?shiftId=${shiftId}&date=${dateStr}`,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        // Set basic info
                        document.getElementById('modalShiftName').innerText = response.shiftName;
                        document.getElementById('modalShiftTime').innerText = response.startTime + ' - ' + response.endTime;
                        document.getElementById('modalShiftDate').innerText = response.date;

                        // Set the edit link to pass date parameter so they modify this specific day
                        document.getElementById('modalEditScheduleBtn').href = `/ScheduleManagement/Schedules?date=${dateStr}`;

                        activeShiftStaffData = response.staff;
                        
                        // Reset filters
                        document.getElementById('modalRoleFilter').value = 'All';
                        document.getElementById('modalSearchInput').value = '';

                        // Render table
                        renderModalStaffTable(activeShiftStaffData);

                        // Show modal
                        const myModal = new bootstrap.Modal(document.getElementById('shiftDetailsModal'));
                        myModal.show();
                    } else {
                        alert(response.message || 'Lỗi khi lấy chi tiết ca.');
                    }
                },
                error: function() {
                    alert('Không thể kết nối tới hệ thống để lấy dữ liệu.');
                }
            });
        }

        function renderModalStaffTable(data) {
            const tbody = document.getElementById('modalStaffTableBody');
            tbody.innerHTML = '';
            if (data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Chưa có nhân sự nào được phân vào ca này.</td></tr>';
                return;
            }

            data.forEach(staff => {
                const tr = document.createElement('tr');
                let statusBadge = `<span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-0.5" style="font-size: 0.75rem;">${staff.status}</span>`;
                if (staff.status === "Off") {
                    statusBadge = `<span class="badge bg-secondary bg-opacity-10 text-danger border border-danger px-2 py-0.5" style="font-size: 0.75rem;">Nghỉ phép</span>`;
                }

                tr.innerHTML = `
                    <td class="px-3 py-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar-circle" style="width: 28px; height: 28px; font-size: 0.9rem; border-radius: 50%; background-color: #e9ecef; color: #495057; display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">${staff.name}</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">${staff.email}</div>
                            </div>
                        </div>
                    </td>
                    <td class="py-2 text-secondary font-monospace" style="font-size: 0.8rem;">${staff.citizenId}</td>
                    <td class="py-2 text-secondary" style="font-size: 0.8rem;">${staff.phone}</td>
                    <td class="py-2"><span class="badge bg-light text-dark border px-2 py-0.5" style="font-size: 0.75rem;">${staff.role}</span></td>
                    <td class="py-2 text-center">${statusBadge}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Apply filters on role change or search input
        document.getElementById('modalRoleFilter').addEventListener('change', filterModalStaff);
        document.getElementById('modalSearchInput').addEventListener('input', filterModalStaff);

        function filterModalStaff() {
            const role = document.getElementById('modalRoleFilter').value;
            const search = document.getElementById('modalSearchInput').value.toLowerCase().trim();

            const filtered = activeShiftStaffData.filter(s => {
                const matchRole = (role === 'All' || s.role === role);
                const matchSearch = s.name.toLowerCase().includes(search) || s.email.toLowerCase().includes(search);
                return matchRole && matchSearch;
            });

            renderModalStaffTable(filtered);
        }

        function renderGrid() {
            const tbody = document.getElementById("gridTbody");
            tbody.innerHTML = "";

            if (dbShifts.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">Chưa có danh mục ca làm việc trong CSDL.</td></tr>`;
                return;
            }

            dbShifts.forEach(shift => {
                const tr = document.createElement("tr");

                // Shift Column
                const tdShift = document.createElement("td");
                tdShift.className = "align-middle text-center fw-bold schedule-cell-white text-brand-deep-purple";
                tdShift.innerHTML = `
                    <div>${shift.name}</div>
                    <div class="text-muted small fw-normal mt-1">${shift.timeRange}</div>
                `;
                tr.appendChild(tdShift);

                // Day Columns
                const localToday = new Date();
                const year = localToday.getFullYear();
                const month = String(localToday.getMonth() + 1).padStart(2, '0');
                const dateVal = String(localToday.getDate()).padStart(2, '0');
                const todayStr = `${year}-${month}-${dateVal}`;

                days.forEach(dayStr => {
                    const td = document.createElement("td");
                    const isPast = dayStr < todayStr;
                    td.className = "grid-cell schedule-cell-white p-2 align-top";
                    if (isPast) {
                        td.style.opacity = "0.7";
                    }
                    td.onclick = function() {
                        showShiftDetails(shift.id, dayStr);
                    };

                    // Check DB schedules for this cell
                    const dbCellScheds = dbSchedulesRaw.filter(s => s.shiftId === shift.id && s.workDate === dayStr);
                    const activeScheds = dbCellScheds.filter(s => s.status !== "Off");
                    const offScheds = dbCellScheds.filter(s => s.status === "Off");

                    let blocks = [];
                    if (activeScheds.length > 0) {
                        const roleCounts = {};
                        activeScheds.forEach(s => {
                            roleCounts[s.roleName] = (roleCounts[s.roleName] || 0) + 1;
                        });
                        Object.keys(roleCounts).forEach(r => {
                            blocks.push({ role: r, count: roleCounts[r] });
                        });
                    }

                    let innerHtml = `<div class="d-flex flex-column gap-1">`;
                    blocks.forEach(b => {
                        const badgeClass = getRoleBadgeClass(b.role);
                        innerHtml += `
                            <div class="p-1 px-2 rounded small fw-medium text-center ${badgeClass}">
                                ${b.count} ${b.role}
                            </div>
                        `;
                    });

                    offScheds.forEach(s => {
                        innerHtml += `
                            <div class="p-1 px-2 rounded small fw-semibold text-center text-danger bg-secondary bg-opacity-10 border border-danger border-opacity-20 text-truncate" style="font-size: 0.72rem;" title="${s.accountName} - Nghỉ phép">
                                <i class="fa-solid fa-user-slash text-danger me-1"></i>${s.accountName} - Nghỉ phép
                            </div>
                        `;
                    });
                    innerHtml += `</div>`;
                    
                    if (!isPast) {
                        innerHtml += `<button class="btn btn-sm btn-outline-secondary btn-add-cell" title="Thêm nhân sự" onclick="event.stopPropagation(); window.location.href='/ScheduleManagement/Schedules?date=${dayStr}';"><i class="fa-solid fa-plus"></i></button>`;
                    }

                    td.innerHTML = innerHtml;
                    tr.appendChild(td);
                });

                tbody.appendChild(tr);
            });
        }

        function runAutoSchedule(startDateStr) {
            if (confirm("Bạn có chắc muốn tự động xếp lịch cho tất cả nhân viên trong tuần này dựa trên Ca mặc định của họ?")) {
                $.post('/ScheduleManagement/GenerateSchedule', { startDate: startDateStr }, function(res) {
                    alert(res.message || 'Tự động xếp lịch thành công!');
                    location.reload();
                }).fail(function(err) {
                    alert('Lỗi: ' + (err.responseText || 'Không thể tự động xếp lịch.'));
                });
            }
        }

        document.addEventListener("DOMContentLoaded", renderGrid);
    </script>
}
