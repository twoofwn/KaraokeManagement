@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minh Tuấn KTV - Login</title>

    <!-- Custom CSS -->
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true" />

    <!-- Font Awesome Icons CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Gradient Mesh Background -->
    <div class="mesh-background">
        <div class="mesh-item mesh-1 top-left"></div>
        <div class="mesh-item mesh-1 bottom-right"></div>
        <div class="mesh-item mesh-2 top-right"></div>
    </div>

    <!-- Main Container -->
    <div class="login-container">

        <!-- Header -->
        <div class="login-header">
            <div class="logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="logo-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </div>
            <h1 class="login-title">Minh Tuấn KTV</h1>
            <p class="login-subtitle">Premium Venue Management</p>
        </div>

        <!-- Form Card -->
        <div class="login-card">

            <!-- Error Alert -->
            @if (ViewBag.Error != null)
            {
                <div class="error-alert">
                    <i class="fa-solid fa-circle-exclamation error-icon"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" autocomplete="off" class="login-form">

                <!-- Username Input -->
                <div class="form-group">
                    <label for="UsernameOrEmail" class="input-label">Username or Email</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-regular fa-user"></i>
                        </span>
                        <input type="text" name="UsernameOrEmail" id="UsernameOrEmail" class="input-field" placeholder="admin@lumina.com" required />
                    </div>
                </div>

                <!-- Password Input -->
                <div class="form-group">
                    <label for="Password" class="input-label">Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" name="Password" id="Password" class="input-field password-field" placeholder="••••••••" required />
                        <button type="button" id="togglePassword" class="toggle-password" tabindex="-1">
                            <i class="fa-regular fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Options -->
                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" name="RememberMe" id="RememberMe" value="true" />
                        <div class="checkbox-box">
                            <i class="fa-solid fa-check check-icon"></i>
                        </div>
                        <span class="remember-text">Remember Me</span>
                    </label>

                    <a href="#" class="forgot-password">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <div class="form-submit">
                    <button type="submit" class="btn-submit">
                        <span>Login</span>
                        <i class="fa-solid fa-arrow-right btn-icon"></i>
                    </button>
                </div>
            </form>

            <!-- Card Footer -->
            <div class="card-footer">
                Accessing VIP systems? <a href="#" class="request-access">Request Access</a>
            </div>

        </div>
    </div>

    <!-- Password toggle logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('Password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (togglePassword && passwordInput && eyeIcon) {
                togglePassword.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        eyeIcon.classList.remove('fa-eye');
                        eyeIcon.classList.add('fa-eye-slash');
                    } else {
                        eyeIcon.classList.remove('fa-eye-slash');
                        eyeIcon.classList.add('fa-eye');
                    }
                });
            }
        });
    </script>
</body>
</html>