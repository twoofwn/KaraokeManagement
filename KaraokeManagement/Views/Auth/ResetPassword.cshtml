@model KaraokeManagement.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Đặt lại mật khẩu - Minh Tuấn Karaoke</title>
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <h2>Đặt lại mật khẩu</h2>

            @if (ViewBag.Error != null)
            {
                <div class="error-alert"><span>@ViewBag.Error</span></div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label>Mật khẩu mới</label>
                    <input type="password" asp-for="NewPassword" required class="input-field" />
                </div>
                <div class="form-group">
                    <label>Xác nhận mật khẩu mới</label>
                    <input type="password" asp-for="ConfirmPassword" required class="input-field" />
                </div>
                <button type="submit" class="btn-submit" style="margin-top: 15px;">Cập nhật mật khẩu</button>
            </form>
        </div>
    </div>
</body>
</html>