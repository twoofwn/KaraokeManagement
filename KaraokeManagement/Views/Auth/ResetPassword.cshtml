@model KaraokeManagement.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - Minh Tuấn Karaoke</title>

    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    <style>
        .match-success {
            color: #10B981 !important;
        }
    </style>
</head>
<body>

    <div class="mesh-background">
        <div class="mesh-item top-left mesh-1"></div>
        <div class="mesh-item bottom-right mesh-1"></div>
        <div class="mesh-item top-right mesh-2"></div>
    </div>

    <div class="login-container">
        <div class="login-card">

            <div style="text-align: center; margin-bottom: 24px;">
                <h1 class="login-title">Đặt lại mật khẩu</h1>
                <p class="login-subtitle">Nhập mật khẩu mới cho tài khoản của bạn</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-alert">
                    <i class="fa-solid fa-circle-exclamation error-icon"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-action="ResetPassword" method="post" class="login-form">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label asp-for="NewPassword" class="input-label">Mật khẩu mới</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" asp-for="NewPassword" id="NewPassword" placeholder="••••••••" required
                               class="input-field password-field" />
                        <button type="button" id="toggleNewPassword" class="toggle-password" tabindex="-1">
                            <i class="fa-regular fa-eye" id="eyeIconNew"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="input-label">Xác nhận mật khẩu mới</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>
                        <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder="••••••••" required
                               class="input-field password-field" />
                        <button type="button" id="toggleConfirmPassword" class="toggle-password" tabindex="-1">
                            <i class="fa-regular fa-eye" id="eyeIconConfirm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>


                <div class="form-submit">
                    <button type="submit" class="btn-submit">
                        <span>Cập nhật mật khẩu</span>
                        <i class="fa-solid fa-check btn-icon"></i>
                    </button>
                </div>
            </form>

            <div style="margin-top: 20px; text-align: center;">
                <a asp-action="Login" style="color: #000; text-decoration: none; font-size: 0.9rem; transition: color 0.2s;">
                    <i class="fa-solid fa-arrow-left" style="margin-right: 5px;"></i> Quay lại đăng nhập
                </a>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const newPwdInput = document.getElementById('NewPassword');
            const confirmPwdInput = document.getElementById('ConfirmPassword');
            const eyeIconConfirm = document.getElementById('eyeIconConfirm');
            const toggleConfirmBtn = document.getElementById('toggleConfirmPassword');

            function setupTogglePassword(buttonId, inputId, iconId) {
                const toggleBtn = document.getElementById(buttonId);
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (toggleBtn && input && icon) {
                    toggleBtn.addEventListener('click', () => {
                        if (icon.classList.contains('fa-circle-check')) return;

                        const isPassword = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPassword ? 'text' : 'password');

                        if (isPassword) {
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    });
                }
            }

            setupTogglePassword('toggleNewPassword', 'NewPassword', 'eyeIconNew');
            setupTogglePassword('toggleConfirmPassword', 'ConfirmPassword', 'eyeIconConfirm');

            function checkPasswordMatch() {
                const valNew = newPwdInput.value;
                const valConfirm = confirmPwdInput.value;

                if (valNew !== '' && valConfirm !== '' && valNew === valConfirm) {
                    eyeIconConfirm.className = 'fa-solid fa-circle-check match-success';
                } else {
                    eyeIconConfirm.classList.remove('fa-circle-check', 'match-success', 'fa-solid');
                    eyeIconConfirm.classList.add('fa-regular');

                    const isPassword = confirmPwdInput.getAttribute('type') === 'password';
                    eyeIconConfirm.classList.add(isPassword ? 'fa-eye' : 'fa-eye-slash');
                }
            }

            newPwdInput.addEventListener('input', checkPasswordMatch);
            confirmPwdInput.addEventListener('input', checkPasswordMatch);
        });
    </script>
</body>
</html>