@{
    Layout = null;
    string email = ViewBag.Email as string ?? "";
    string actionType = ViewBag.ActionType as string ?? "Register"; // Register hoặc ResetPassword
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minh Tuấn Karaoke - Xác thực OTP</title>

    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
</head>
<body>

    <div class="mesh-background">
        <div class="mesh-item top-left mesh-1"></div>
        <div class="mesh-item bottom-right mesh-1"></div>
        <div class="mesh-item top-right mesh-2"></div>
    </div>

    <div class="login-container">

        <div class="login-header">
            <div class="logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="logo-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </div>
            <h1 class="login-title">Xác thực mã OTP</h1>
            <p class="login-subtitle">Mã xác thực đã được gửi tới @email</p>
        </div>

        <div class="login-card">

            @if (ViewBag.Error != null)
            {
                <div class="error-alert">
                    <i class="fa-solid fa-circle-exclamation error-icon"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="VerifyOtp" method="post" class="login-form">
                <!-- Hidden inputs để lưu ngữ cảnh -->
                <input type="hidden" name="email" value="@email" />
                <input type="hidden" name="actionType" value="@actionType" />

                <div class="form-group">
                    <label for="otpCode" class="input-label">Mã OTP (6 chữ số)</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>
                        <input type="text" name="otpCode" id="otpCode" placeholder="123456" maxlength="6" required
                               class="input-field" style="letter-spacing: 0.2em; font-weight: 700; text-align: center;" />
                    </div>
                </div>

                <div class="form-submit">
                    <button type="submit" class="btn-submit">
                        <span>Xác nhận</span>
                        <i class="fa-solid fa-check btn-icon"></i>
                    </button>
                </div>
            </form>

        </div>
    </div>

</body>
</html>