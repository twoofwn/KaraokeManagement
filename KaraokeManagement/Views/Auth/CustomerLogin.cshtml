@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minh Tuấn Karaoke - Đăng nhập Khách hàng</title>

    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
</head>
<body>

    <div class="mesh-background">
        <div class="mesh-item top-left mesh-1"></div>
        <div class="mesh-item bottom-right mesh-1"></div>
        <div class="mesh-item top-right mesh-2"></div>
    </div>

    <div class="login-container">

        <div class="login-header">
            <div class="logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="logo-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </div>
            <h1 class="login-title">Minh Tuấn Karaoke</h1>
            <p class="login-subtitle">Đăng nhập Dành cho Khách hàng</p>
        </div>

        <div class="login-card">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="error-alert" style="background-color: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #10b981;">
                    <i class="fa-solid fa-circle-check error-icon"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="error-alert">
                    <i class="fa-solid fa-circle-exclamation error-icon"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="CustomerLogin" method="post" class="login-form">
                <div class="form-group">
                    <label for="PhoneOrEmail" class="input-label">Email</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-regular fa-user"></i>
                        </span>
                        <input type="text" name="PhoneOrEmail" id="PhoneOrEmail" placeholder="example@gmail.com" required class="input-field" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="Password" class="input-label">Mật khẩu</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" name="Password" id="Password" placeholder="••••••••" required class="input-field password-field" />
                        <button type="button" id="togglePassword" class="toggle-password" tabindex="-1">
                            <i class="fa-regular fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group" style="text-align: right;">
                    <a asp-controller="Auth" asp-action="ForgotPassword" style="color: #6366f1; text-decoration: none; font-size: 0.9rem;">
                        Quên mật khẩu?
                    </a>
                </div>

                <div class="form-submit">
                    <button type="submit" class="btn-submit">
                        <span>Đăng nhập</span>
                        <i class="fa-solid fa-arrow-right btn-icon"></i>
                    </button>
                </div>

                <div class="form-group" style="text-align: center;">
                    <a asp-controller="Auth" asp-action="Register" style="color: #6366f1; text-decoration: none; font-size: 0.9rem;">
                        Chưa có tài khoản? Đăng ký
                    </a>
                </div>
            </form>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('Password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (togglePassword && passwordInput && eyeIcon) {
                togglePassword.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        eyeIcon.classList.remove('fa-eye');
                        eyeIcon.classList.add('fa-eye-slash');
                    } else {
                        eyeIcon.classList.remove('fa-eye-slash');
                        eyeIcon.classList.add('fa-eye');
                    }
                });
            }
        });
    </script>
</body>
</html>