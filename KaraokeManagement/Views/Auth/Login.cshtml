@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minh Tuấn KTV - Login</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        
        .animate-fade-in-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Gradient mesh items */
        .mesh-gradient-1 {
            background: radial-gradient(circle, rgba(236, 0, 140, 0.15) 0%, rgba(236, 0, 140, 0) 70%);
        }
        .mesh-gradient-2 {
            background: radial-gradient(circle, rgba(147, 51, 234, 0.12) 0%, rgba(147, 51, 234, 0) 70%);
        }
    </style>
</head>
<body class="bg-[#FAF8F5] min-h-screen flex flex-col justify-center items-center p-4 relative overflow-x-hidden select-none">

    <!-- Gradient Mesh Background -->
    <div class="absolute inset-0 -z-10 w-full h-full overflow-hidden pointer-events-none">
        <div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] mesh-gradient-1 blur-[80px]"></div>
        <div class="absolute -bottom-[20%] -right-[10%] w-[70%] h-[70%] mesh-gradient-1 blur-[100px]"></div>
        <div class="absolute top-[30%] right-[10%] w-[45%] h-[45%] mesh-gradient-2 blur-[90px]"></div>
    </div>

    <!-- Main Container -->
    <div class="w-full max-w-[440px] flex flex-col items-center animate-fade-in-up">
        
        <!-- Header -->
        <div class="text-center mb-8">
            <!-- Squircle Logo Container -->
            <div class="w-16 h-16 bg-gradient-to-br from-[#ec008c] to-[#9333ea] rounded-[22px] flex items-center justify-center shadow-lg shadow-pink-500/25 mx-auto mb-4 hover:rotate-3 transition-transform duration-300">
                <!-- Music/Microphone Glowing SVG Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="w-8 h-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </div>
            <!-- Titles -->
            <h1 class="text-[26px] font-extrabold text-gray-900 tracking-tight">Minh Tuấn KTV</h1>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.15em] mt-1.5">Premium Venue Management</p>
        </div>

        <!-- Form Card -->
        <div class="w-full bg-white rounded-[24px] shadow-[0_12px_40px_-12px_rgba(0,0,0,0.06)] border border-gray-100 p-8 sm:p-10 transition-shadow duration-300 hover:shadow-[0_16px_48px_-10px_rgba(0,0,0,0.08)]">
            
            <!-- Error Alert -->
            @if (ViewBag.Error != null)
            {
                <div class="mb-6 p-4 bg-red-50/70 border border-red-100 rounded-2xl flex items-start space-x-3 text-red-600 text-xs font-semibold animate-shake">
                    <i class="fa-solid fa-circle-exclamation text-base mt-0.5"></i>
                    <span class="leading-relaxed">@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" autocomplete="off" class="space-y-6">
                <!-- Username Input -->
                <div class="space-y-2">
                    <label for="UsernameOrEmail" class="text-[10px] font-bold text-gray-400 tracking-wider uppercase block">Username or Email</label>
                    <div class="relative flex items-center group">
                        <span class="absolute left-4 text-gray-400 group-focus-within:text-[#ec008c] transition-colors duration-200">
                            <i class="fa-regular fa-user text-sm"></i>
                        </span>
                        <input type="text" name="UsernameOrEmail" id="UsernameOrEmail" placeholder="admin@lumina.com" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200/70 rounded-2xl text-sm text-gray-800 placeholder-gray-400/80 focus:outline-none focus:ring-4 focus:ring-pink-500/10 focus:border-[#ec008c] focus:bg-white transition-all duration-200" />
                    </div>
                </div>

                <!-- Password Input -->
                <div class="space-y-2">
                    <label for="Password" class="text-[10px] font-bold text-gray-400 tracking-wider uppercase block">Password</label>
                    <div class="relative flex items-center group">
                        <span class="absolute left-4 text-gray-400 group-focus-within:text-[#ec008c] transition-colors duration-200">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input type="password" name="Password" id="Password" placeholder="••••••••" required
                               class="w-full pl-11 pr-11 py-3.5 bg-gray-50 border border-gray-200/70 rounded-2xl text-sm text-gray-800 placeholder-gray-400/80 focus:outline-none focus:ring-4 focus:ring-pink-500/10 focus:border-[#ec008c] focus:bg-white transition-all duration-200" />
                        <button type="button" id="togglePassword" class="absolute right-4 text-gray-400 hover:text-gray-600 transition-colors focus:outline-none" tabindex="-1">
                            <i class="fa-regular fa-eye text-sm" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Options -->
                <div class="flex items-center justify-between pt-1">
                    <!-- Circular Checkbox -->
                    <label class="flex items-center space-x-2.5 cursor-pointer select-none">
                        <div class="relative">
                            <input type="checkbox" name="RememberMe" id="RememberMe" class="sr-only peer" value="true" />
                            <div class="w-5 h-5 rounded-full border border-gray-300 bg-white peer-checked:bg-[#ec008c] peer-checked:border-[#ec008c] flex items-center justify-center transition-all duration-200 shadow-sm">
                                <i class="fa-solid fa-check text-[10px] text-white opacity-0 peer-checked:opacity-100 transition-opacity duration-200"></i>
                            </div>
                        </div>
                        <span class="text-xs font-semibold text-gray-500">Remember Me</span>
                    </label>

                    <!-- Forgot Password -->
                    <a href="#" class="text-xs font-bold text-[#ec008c] hover:text-[#c40072] transition-colors">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="group w-full py-4 bg-gradient-to-r from-[#ec008c] to-[#d80073] hover:from-[#c40072] hover:to-[#be0065] text-white font-bold rounded-full shadow-lg shadow-pink-500/15 hover:shadow-pink-500/25 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center space-x-2">
                        <span>Login</span>
                        <i class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1.5"></i>
                    </button>
                </div>
            </form>

            <!-- Card Footer -->
            <div class="mt-8 text-center text-xs text-gray-400 font-medium">
                Accessing VIP systems? <a href="#" class="text-[#ec008c] font-bold hover:underline ml-1">Request Access</a>
            </div>

        </div>
    </div>

    <!-- Password toggle logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('Password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (togglePassword && passwordInput && eyeIcon) {
                togglePassword.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    
                    if (isPassword) {
                        eyeIcon.classList.remove('fa-eye');
                        eyeIcon.classList.add('fa-eye-slash');
                    } else {
                        eyeIcon.classList.remove('fa-eye-slash');
                        eyeIcon.classList.add('fa-eye');
                    }
                });
            }
        });
    </script>
</body>
</html>
