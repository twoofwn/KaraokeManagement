@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Category" : "Add Category";
    ViewData["ActiveNav"] = "categories";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Category" : "Add Category")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin">Admin</a>
            <span class="breadcrumb-sep">/</span>
            <a href="/Categories">Categories</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Edit" : "Create New")</span>
        </nav>
    </div>
</div>

<div class="form-layout-narrow">
    <div class="form-card">
        <form id="categoryForm">

            <div class="field-group" style="margin-bottom:20px;">
                <label class="field-label">Category Name</label>
                <input type="text"
                       name="CategoryName"
                       class="field-input"
                       placeholder="e.g. Bia, Rượu, Đồ Ăn..."
                       value="@(isEdit ? "Bia" : "")"
                       required />
                <span class="field-hint">Tên danh mục hiển thị trên menu.</span>
            </div>

            <div class="field-group" style="margin-bottom:24px;">
                <label class="field-label">Icon (optional)</label>
                <div class="icon-picker-row">
                    @foreach (var icon in new[] {
                        ("fa-beer-mug-empty","🍺"),("fa-wine-bottle","🍷"),
                        ("fa-droplet","💧"),("fa-utensils","🍴"),
                        ("fa-apple-whole","🍎"),("fa-gift","🎁")
                    })
                    {
                        <label class="icon-pick-item">
                            <input type="radio" name="CategoryIcon" value="@icon.Item1" class="icon-radio" />
                            <span class="icon-pick-box">
                                <i class="fa-solid @icon.Item1"></i>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="field-group" style="margin-bottom:28px;">
                <label class="field-label">Status</label>
                <div class="select-wrapper">
                    <select name="Status" class="field-select">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Categories" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(isEdit ? "Update Category" : "Save Category")
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.icon-radio').forEach(radio => {
        radio.addEventListener('change', () => {
            document.querySelectorAll('.icon-pick-box').forEach(b => b.classList.remove('selected'));
            radio.nextElementSibling.classList.add('selected');
        });
    });

    document.getElementById('categoryForm').addEventListener('submit', e => {
        e.preventDefault();
        alert('@(isEdit ? "Category updated!" : "Category saved!")');
    });
</script>
}
