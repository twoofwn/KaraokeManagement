@model KaraokeManagement.Models.RoomImage
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = Model.RoomImageId > 0;
    ViewData["Title"] = isEdit ? "Sửa ảnh phòng" : "Thêm ảnh phòng";
    ViewData["ActiveNav"] = "roomimages";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Sửa ảnh phòng" : "Thêm ảnh phòng")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin/RoomImages">Ảnh phòng</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Sửa" : "Thêm")</span>
        </nav>
    </div>
</div>

<div class="table-card" style="max-width:600px;">
    <div class="table-card-header">
        <h2 class="table-card-title">@(isEdit ? "Cập nhật ảnh" : "Thêm ảnh mới")</h2>
    </div>

    <form method="post"
          action="@(isEdit ? $"/Admin/RoomImageEdit/{Model.RoomImageId}" : "/Admin/RoomImageCreate")"
          style="padding:24px;display:flex;flex-direction:column;gap:20px;">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" name="RoomImageId" value="@Model.RoomImageId" />
        }

        <div class="form-group">
            <label class="form-label">Phòng <span style="color:#e74c3c">*</span></label>
            @Html.DropDownList("RoomId", (IEnumerable<SelectListItem>)ViewBag.Rooms, "-- Chọn phòng --", new { @class = "form-control", required = "required" })
            <span asp-validation-for="RoomId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Image URL <span style="color:#e74c3c">*</span></label>
            <input type="text" name="ImageUrl" class="form-control" value="@Model.ImageUrl"
                   placeholder="https://example.com/image.jpg" required maxlength="500" />
            <span asp-validation-for="ImageUrl" class="field-error"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="form-group">
                <label class="form-label">Preview</label>
                <img src="@Model.ImageUrl" alt="preview"
                     style="max-width:320px;max-height:200px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />
            </div>
        }

        <div style="display:flex;gap:12px;margin-top:8px;">
            <button type="submit" class="btn-primary-sm">
                <i class="fa-solid fa-floppy-disk"></i> @(isEdit ? "Lưu thay đổi" : "Thêm ảnh")
            </button>
            <a href="/Admin/RoomImages" class="btn-secondary-sm">Hủy</a>
        </div>
    </form>
</div>
