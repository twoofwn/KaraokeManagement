@model KaraokeManagement.Models.Category
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Category" : "Add Category";
    ViewData["ActiveNav"] = "categories";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Category" : "Add Category")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin/Categories">Categories</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Edit" : "Create New")</span>
        </nav>
    </div>
</div>

<div class="form-layout-narrow">
    <div class="form-card">
        <form method="post"
              asp-action="@(isEdit ? "CategoryEdit" : "CategoryCreate")"
              asp-controller="Admin"
              asp-route-id="@(isEdit ? Model.CategoryId : 0)">

            <div class="field-group" style="margin-bottom:28px;">
                <label class="field-label">Category Name</label>
                <input asp-for="CategoryName" class="field-input" placeholder="e.g. Bia, Rượu, Đồ Ăn..." />
                <span asp-validation-for="CategoryName" class="field-error"></span>
                <span class="field-hint">Tên danh mục hiển thị trên menu.</span>
            </div>

            <div class="form-actions">
                <a href="/Admin/Categories" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(isEdit ? "Update Category" : "Save Category")
                </button>
            </div>
        </form>
    </div>
</div>
