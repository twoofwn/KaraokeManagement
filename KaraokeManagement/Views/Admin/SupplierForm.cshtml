@model KaraokeManagement.Models.Supplier
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Supplier" : "Add Supplier";
    ViewData["ActiveNav"] = "suppliers";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Supplier" : "Add Supplier")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin/Suppliers">Suppliers</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Edit" : "Create New")</span>
        </nav>
    </div>
</div>

<div class="form-layout-narrow">
    <div class="form-card">
        <form method="post"
              asp-action="@(isEdit ? "SupplierEdit" : "SupplierCreate")"
              asp-controller="Admin"
              asp-route-id="@(isEdit ? Model.SupplierId : 0)">

            <div class="field-group" style="margin-bottom:24px;">
                <label class="field-label">Supplier Name</label>
                <input asp-for="SupplierName" class="field-input" placeholder="e.g. Công ty TNHH Bia Sài Gòn..." />
                <span asp-validation-for="SupplierName" class="field-error"></span>
            </div>

            <div class="form-row-2">
                <div class="field-group">
                    <label class="field-label">Contact Name</label>
                    <input asp-for="ContactName" class="field-input" placeholder="Người liên hệ" />
                </div>
                <div class="field-group">
                    <label class="field-label">Phone</label>
                    <input asp-for="Phone" class="field-input" placeholder="0901 234 567" />
                </div>
            </div>

            <div class="field-group" style="margin-bottom:28px;">
                <label class="field-label">Address</label>
                <input asp-for="Address" class="field-input" placeholder="Địa chỉ nhà cung cấp" />
            </div>

            <div class="form-actions">
                <a href="/Admin/Suppliers" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(isEdit ? "Update Supplier" : "Save Supplier")
                </button>
            </div>
        </form>
    </div>
</div>
