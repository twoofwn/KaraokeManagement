@model IEnumerable<KaraokeManagement.Models.Supplier>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Suppliers";
    ViewData["ActiveNav"] = "suppliers";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Suppliers</h1>
        <nav class="breadcrumb-nav">
            <span class="breadcrumb-current">Suppliers</span>
        </nav>
    </div>
    <a href="/Admin/SupplierCreate" class="btn-primary-sm">
        <i class="fa-solid fa-plus"></i> Add Supplier
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="admin-alert error">
        <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
    </div>
}

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Nhà cung cấp</h2>
        <form method="get" action="/Admin/Suppliers" class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên, SĐT..." />
        </form>
        <span class="record-count">@ViewBag.TotalCount records</span>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Supplier Name</th>
                <th>Contact</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Orders</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.SupplierId</td>
                    <td>@supplier.SupplierName</td>
                    <td>@supplier.ContactName</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Address</td>
                    <td><span class="category-chip-plain">@supplier.PurchaseOrders.Count phiếu nhập</span></td>
                    <td class="table-actions">
                        <a href="/Admin/SupplierEdit/@supplier.SupplierId" class="action-btn edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form method="post" action="/Admin/SupplierDelete/@supplier.SupplierId"
                              onsubmit="return confirm('Xóa nhà cung cấp này?')" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="action-btn delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center;color:#a09098;padding:32px;">
                        Chưa có nhà cung cấp nào. <a href="/Admin/SupplierCreate">Thêm mới</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager")
</div>
