@model IEnumerable<KaraokeManagement.Models.Account>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
    ViewData["ActiveNav"] = "users";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <nav class="breadcrumb-nav">
            <span class="breadcrumb-current">Users</span>
        </nav>
    </div>
    <a href="javascript:void(0)" onclick="handleCreate()" class="btn-primary-sm">
        <i class="fa-solid fa-plus"></i> Add User
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="admin-alert error">
        <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
    </div>
}

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Staff Accounts</h2>
        <form method="get" action="/Admin/Users" class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên, username, role..." />
        </form>
        <span class="record-count">@ViewBag.TotalCount records</span>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Staff</th>
                <th>Username</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roleName = user.Role?.RoleName ?? "";
                var roleClass = roleName switch { "Admin" => "admin", "Manager" => "manager", _ => "receptionist" };
                <tr>
                    <td>@user.AccountId</td>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar">@user.FullName[0]</div>
                            <div>
                                <div class="user-name">@user.FullName</div>
                                <div class="user-email">@user.Email</div>
                            </div>
                        </div>
                    </td>
                    <td><code class="username-code">@user.Username</code></td>
                    <td>@user.Phone</td>
                    <td><span class="role-badge @roleClass">@roleName</span></td>
                    <td>@user.CreatedAt?.ToString("dd/MM/yyyy")</td>
                    <td class="table-actions">
                        <a href="javascript:void(0)" onclick="handleEdit(@user.AccountId)" class="action-btn edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form id="delete-form-@user.AccountId" method="post" action="/Admin/UserDelete/@user.AccountId" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="button" onclick="handleDelete(@user.AccountId, '@user.Username')" class="action-btn delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center;color:#a09098;padding:32px;">
                        Chưa có tài khoản nào. <a href="javascript:void(0)" onclick="handleCreate()">Thêm mới</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager")
</div>

@section Scripts {
<script>
    async function verifyPassword() {
        const password = prompt("Nhập mật khẩu tài khoản Admin của bạn để tiếp tục:");
        if (password === null) return null; // Cancelled
        if (password.trim() === "") {
            alert("Mật khẩu không được trống!");
            return false;
        }

        try {
            const response = await fetch('/Admin/VerifyAdminPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({ password: password })
            });
            const data = await response.json();
            if (data.success) {
                return true;
            } else {
                alert(data.message || "Mật khẩu Admin không chính xác!");
                return false;
            }
        } catch (error) {
            console.error("Error verifying password:", error);
            alert("Lỗi hệ thống khi kiểm tra mật khẩu.");
            return false;
        }
    }

    async function handleEdit(accountId) {
        const verified = await verifyPassword();
        if (verified === true) {
            window.location.href = `/Admin/UserEdit/${accountId}`;
        }
    }

    async function handleCreate() {
        const verified = await verifyPassword();
        if (verified === true) {
            window.location.href = '/Admin/UserCreate';
        }
    }

    async function handleDelete(accountId, username) {
        if (!confirm(`Bạn có chắc chắn muốn xóa tài khoản ${username}?`)) {
            return;
        }
        const verified = await verifyPassword();
        if (verified === true) {
            document.getElementById(`delete-form-${accountId}`).submit();
        }
    }
</script>
}
