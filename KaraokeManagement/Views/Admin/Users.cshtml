@model IEnumerable<KaraokeManagement.Models.Account>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
    ViewData["ActiveNav"] = "users";
    int? currentAccountId = ViewBag.CurrentAccountId as int?;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <nav class="breadcrumb-nav">
            <span class="breadcrumb-current">Users</span>
        </nav>
    </div>
    <a href="javascript:void(0)" onclick="handleCreate()" class="btn-primary-sm">
        <i class="fa-solid fa-plus"></i> Add User
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="admin-alert error">
        <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="admin-alert success" style="background: #e2fcdb; color: #2e7d32; border: 1px solid #a5d6a7; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Staff Accounts</h2>
        <form method="get" action="/Admin/Users" class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên, username, role..." />
        </form>
        <span class="record-count">@ViewBag.TotalCount records</span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Staff</th>
                <th>Username</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Created At</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roleName = user.Role?.RoleName ?? "";
                var roleClass = roleName switch { "Admin" => "admin", "Manager" => "manager", _ => "receptionist" };
                <tr>
                    <td>@user.AccountId</td>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar">@user.FullName[0]</div>
                            <div>
                                <div class="user-name">@user.FullName</div>
                                <div class="user-email">@user.Email</div>
                            </div>
                        </div>
                    </td>
                    <td><code class="username-code">@user.Username</code></td>
                    <td>@user.Phone</td>
                    <td><span class="role-badge @roleClass">@roleName</span></td>
                    <td>@user.CreatedAt?.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="role-badge active" style="background-color: #e2fcdb; color: #2e7d32; border: 1px solid #a5d6a7; padding: 4px 8px; border-radius: 4px; font-weight: 500; font-size: 0.85em;">Hoạt động</span>
                        }
                        else
                        {
                            <span class="role-badge inactive" style="background-color: #ffebee; color: #c62828; border: 1px solid #ef9a9a; padding: 4px 8px; border-radius: 4px; font-weight: 500; font-size: 0.85em;">Đã khóa</span>
                        }
                    </td>
                    <td class="table-actions">
                        <a href="javascript:void(0)" onclick="handleEdit(@user.AccountId)" class="action-btn edit" title="Chỉnh sửa tài khoản">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        @if (user.AccountId == currentAccountId)
                        {
                            <button type="button"
                                    class="action-btn"
                                    disabled
                                    title="Không thể khóa tài khoản đang đăng nhập"
                                    style="background:#f2eef4;color:#aaa0ad;cursor:not-allowed;">
                                <i class="fa-solid fa-shield-halved"></i>
                            </button>
                        }
                        else
                        {
                            <form id="status-form-@user.AccountId"
                                  method="post"
                                  action="/Admin/SetUserStatus"
                                  data-username="@user.Username"
                                  style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.AccountId" />
                                <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                @if (user.IsActive)
                                {
                                    <button type="button"
                                            onclick="handleSetStatus(@user.AccountId, false, this)"
                                            class="action-btn delete"
                                            title="Khóa tài khoản">
                                        <i class="fa-solid fa-user-slash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            onclick="handleSetStatus(@user.AccountId, true, this)"
                                            class="action-btn edit"
                                            style="background: #e8f5e9; color: #2e7d32;"
                                            title="Kích hoạt tài khoản">
                                        <i class="fa-solid fa-user-check"></i>
                                    </button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align:center;color:#a09098;padding:32px;">
                        Chưa có tài khoản nào. <a href="javascript:void(0)" onclick="handleCreate()">Thêm mới</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @await Html.PartialAsync("_Pager")
</div>

<div id="statusConfirmModal" class="admin-modal" hidden aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-confirm></div>
    <div class="admin-modal-card admin-modal-card-sm"
         role="dialog"
         aria-modal="true"
         aria-labelledby="statusConfirmTitle">
        <button type="button"
                class="admin-modal-close"
                data-close-confirm
                aria-label="Đóng">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div id="statusConfirmIcon" class="admin-modal-icon danger">
            <i class="fa-solid fa-user-slash"></i>
        </div>
        <h3 id="statusConfirmTitle" class="admin-modal-title">Xác nhận thao tác</h3>
        <p id="statusConfirmMessage" class="admin-modal-message"></p>

        <div class="admin-modal-actions">
            <button type="button" class="admin-modal-btn secondary" data-close-confirm>
                Hủy
            </button>
            <button type="button" id="statusConfirmButton" class="admin-modal-btn danger">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<div id="passwordVerifyModal" class="admin-modal" hidden aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-password></div>
    <div class="admin-modal-card"
         role="dialog"
         aria-modal="true"
         aria-labelledby="passwordVerifyTitle">
        <button type="button"
                class="admin-modal-close"
                data-close-password
                aria-label="Đóng">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="admin-modal-icon security">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h3 id="passwordVerifyTitle" class="admin-modal-title">Xác nhận quyền Admin</h3>
        <p class="admin-modal-message">
            Nhập mật khẩu của tài khoản đang đăng nhập để tiếp tục thao tác.
        </p>

        <form id="passwordVerifyForm">
            <label for="legacyAdminPasswordInput" class="admin-modal-label">Mật khẩu Admin</label>
            <div class="admin-password-control">
                <i class="fa-solid fa-lock"></i>
                <input id="legacyAdminPasswordInput"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Nhập mật khẩu của bạn" />
                <button type="button"
                        id="toggleAdminPassword"
                        aria-label="Hiện hoặc ẩn mật khẩu">
                    <i class="fa-regular fa-eye"></i>
                </button>
            </div>
            <div id="passwordVerifyError" class="admin-modal-error" hidden></div>

            <div class="admin-modal-actions">
                <button type="button" class="admin-modal-btn secondary" data-close-password>
                    Hủy
                </button>
                <button type="submit" id="passwordVerifyButton" class="admin-modal-btn primary">
                    <span class="button-label">Xác nhận</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const confirmModal = document.getElementById('statusConfirmModal');
    const confirmIcon = document.getElementById('statusConfirmIcon');
    const confirmTitle = document.getElementById('statusConfirmTitle');
    const confirmMessage = document.getElementById('statusConfirmMessage');
    const confirmButton = document.getElementById('statusConfirmButton');

    const passwordModal = document.getElementById('passwordVerifyModal');
    const passwordForm = document.getElementById('passwordVerifyForm');
    const passwordInput = document.getElementById('legacyAdminPasswordInput');
    const passwordError = document.getElementById('passwordVerifyError');
    const passwordButton = document.getElementById('passwordVerifyButton');
    const togglePasswordButton = document.getElementById('toggleAdminPassword');

    let confirmResolver = null;
    let passwordResolver = null;
    let passwordRequestRunning = false;

    function setModalVisibility(modal, visible) {
        modal.hidden = !visible;
        modal.setAttribute('aria-hidden', visible ? 'false' : 'true');
        document.body.classList.toggle(
            'admin-modal-open',
            !confirmModal.hidden || !passwordModal.hidden
        );
    }

    function showStatusConfirm(username, targetIsActive) {
        const isActivation = targetIsActive === true;
        return AdminPopup.confirm({
            title: isActivation ? 'Kích hoạt tài khoản?' : 'Khóa tài khoản?',
            message: isActivation
                ? `Tài khoản “${username}” sẽ được phép đăng nhập và sử dụng hệ thống trở lại.`
                : `Tài khoản “${username}” sẽ bị đăng xuất và không thể tiếp tục sử dụng hệ thống.`,
            confirmText: isActivation ? 'Kích hoạt' : 'Khóa tài khoản',
            variant: isActivation ? 'success' : 'danger',
            icon: isActivation
                ? 'fa-solid fa-user-check'
                : 'fa-solid fa-user-slash'
        });
    }

    function closeStatusConfirm(result) {
        setModalVisibility(confirmModal, false);
        const resolver = confirmResolver;
        confirmResolver = null;
        resolver?.(result);
    }

    function showPasswordVerification() {
        passwordForm.reset();
        passwordInput.type = 'password';
        togglePasswordButton.innerHTML = '<i class="fa-regular fa-eye"></i>';
        passwordError.hidden = true;
        passwordError.textContent = '';
        passwordButton.disabled = false;
        passwordButton.classList.remove('loading');
        passwordButton.querySelector('.button-label').textContent = 'Xác nhận';

        setModalVisibility(passwordModal, true);
        window.setTimeout(() => passwordInput.focus(), 50);

        return new Promise(resolve => {
            passwordResolver = resolve;
        });
    }

    function closePasswordVerification(result) {
        if (passwordRequestRunning) return;

        setModalVisibility(passwordModal, false);
        const resolver = passwordResolver;
        passwordResolver = null;
        resolver?.(result);
    }

    async function verifyPassword() {
        return await AdminPopup.verifyPassword();
    }

    passwordForm.addEventListener('submit', async event => {
        event.preventDefault();

        const password = passwordInput.value;
        if (password.trim() === '') {
            passwordError.textContent = 'Vui lòng nhập mật khẩu Admin.';
            passwordError.hidden = false;
            passwordInput.focus();
            return;
        }

        passwordError.hidden = true;
        passwordRequestRunning = true;
        passwordButton.disabled = true;
        passwordButton.classList.add('loading');
        passwordButton.querySelector('.button-label').textContent = 'Đang xác nhận...';

        try {
            const response = await fetch('/Admin/VerifyAdminPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({ password: password })
            });
            const data = await response.json();
            if (data.success) {
                passwordRequestRunning = false;
                setModalVisibility(passwordModal, false);
                const resolver = passwordResolver;
                passwordResolver = null;
                resolver?.(true);
            } else {
                passwordError.textContent = data.message || 'Mật khẩu Admin không chính xác.';
                passwordError.hidden = false;
                passwordInput.select();
            }
        } catch (error) {
            console.error("Error verifying password:", error);
            passwordError.textContent = 'Không thể xác nhận mật khẩu. Vui lòng thử lại.';
            passwordError.hidden = false;
        } finally {
            passwordRequestRunning = false;
            passwordButton.disabled = false;
            passwordButton.classList.remove('loading');
            passwordButton.querySelector('.button-label').textContent = 'Xác nhận';
        }
    });

    togglePasswordButton.addEventListener('click', () => {
        const showPassword = passwordInput.type === 'password';
        passwordInput.type = showPassword ? 'text' : 'password';
        togglePasswordButton.innerHTML = showPassword
            ? '<i class="fa-regular fa-eye-slash"></i>'
            : '<i class="fa-regular fa-eye"></i>';
        passwordInput.focus();
    });

    document.querySelectorAll('[data-close-confirm]').forEach(element => {
        element.addEventListener('click', () => closeStatusConfirm(false));
    });

    document.querySelectorAll('[data-close-password]').forEach(element => {
        element.addEventListener('click', () => closePasswordVerification(null));
    });

    confirmButton.addEventListener('click', () => closeStatusConfirm(true));

    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (!passwordModal.hidden) {
            closePasswordVerification(null);
        } else if (!confirmModal.hidden) {
            closeStatusConfirm(false);
        }
    });

    async function handleEdit(accountId) {
        const verified = await verifyPassword();
        if (verified === true) {
            window.location.href = `/Admin/UserEdit/${accountId}`;
        }
    }

    async function handleCreate() {
        const verified = await verifyPassword();
        if (verified === true) {
            window.location.href = '/Admin/UserCreate';
        }
    }

    const pendingStatusActions = new Set();

    async function handleSetStatus(accountId, targetIsActive, button) {
        if (pendingStatusActions.has(accountId)) return;

        const form = document.getElementById(`status-form-${accountId}`);
        const username = form.dataset.username;
        const confirmed = await showStatusConfirm(username, targetIsActive);
        if (!confirmed) {
            return;
        }

        pendingStatusActions.add(accountId);
        button.disabled = true;

        const verified = await verifyPassword();
        if (verified !== true) {
            pendingStatusActions.delete(accountId);
            button.disabled = false;
            return;
        }

        form.querySelector('input[name="isActive"]').value =
            targetIsActive ? 'true' : 'false';
        form.submit();
    }
</script>
}
