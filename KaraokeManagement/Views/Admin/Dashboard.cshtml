@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <nav class="breadcrumb-nav">
            <span>Admin</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Dashboard</span>
        </nav>
    </div>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-box"></i></div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalItems</div>
            <div class="stat-label">Total Items</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-layer-group"></i></div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalCategories</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalUsers</div>
            <div class="stat-label">Staff Accounts</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-file-invoice"></i></div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalInvoices</div>
            <div class="stat-label">Active Invoices</div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Recent Entries</h2>
        <a href="/Admin/InventoryCreate" class="btn-primary-sm">
            <i class="fa-solid fa-plus"></i> Add New
        </a>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.RecentItems as IEnumerable<KaraokeManagement.Models.ServiceItem> ?? [])
            {
                <tr>
                    <td>@item.ServiceId</td>
                    <td>@item.ServiceName</td>
                    <td><span class="category-chip-plain">@item.Category?.CategoryName</span></td>
                    <td>@item.SellingPrice.ToString("N0")đ</td>
                    <td>@item.StockQuantity</td>
                    <td class="table-actions">
                        <a href="/Admin/InventoryEdit/@item.ServiceId" class="action-btn edit"><i class="fa-solid fa-pen"></i></a>
                        <form method="post" action="/Admin/InventoryDelete/@item.ServiceId" style="display:inline"
                              onsubmit="return confirm('Xóa item này?')">
                            <button type="submit" class="action-btn delete"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
