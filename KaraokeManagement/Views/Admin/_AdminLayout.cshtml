@using System.Security.Claims
@{
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "User";
    var avatar = fullName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdminPanel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="admin-wrapper">

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fa-solid fa-table-columns"></i>
            </div>
            <div>
                <div class="brand-name">Quản trị hệ thống</div>
                <div class="brand-sub">Admin</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="/Admin/Dashboard" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "dashboard" ? "active" : "")">
                <i class="fa-solid fa-table-columns nav-icon"></i>
                <span>Báo cáo hệ thống</span>
            </a>
            <a href="/Admin/Inventory" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "inventory" ? "active" : "")">
                <i class="fa-solid fa-box nav-icon"></i>
                <span>Kho hàng</span>
            </a>
            <a href="/Admin/Categories" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "categories" ? "active" : "")">
                <i class="fa-solid fa-layer-group nav-icon"></i>
                <span>Loại hàng</span>
            </a>
            <a href="/Admin/Rooms" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "rooms" ? "active" : "")">
                <i class="fa-solid fa-door-open nav-icon"></i>
                <span>Phòng hát</span>
            </a>
            <a href="/Admin/RoomTypes" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "roomtypes" ? "active" : "")">
                <i class="fa-solid fa-tags nav-icon"></i>
                <span>Loại phòng</span>
            </a>
            <a href="/Admin/Suppliers" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "suppliers" ? "active" : "")">
                <i class="fa-solid fa-truck-field nav-icon"></i>
                <span>Nhà cung cấp</span>
            </a>
            <a href="/Admin/Users" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "users" ? "active" : "")">
                <i class="fa-solid fa-users nav-icon"></i>
                <span>Tài khoản</span>
            </a>
            <a href="#" class="nav-item @(ViewData["ActiveNav"]?.ToString() == "settings" ? "active" : "")">
                <i class="fa-solid fa-gear nav-icon"></i>
                <span>Cài đặt</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/Auth/Logout" class="sidebar-footer-link">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- Main area -->
    <div class="admin-main">

        <!-- Top header -->
        <header class="admin-header">
            <div@*  class="header-search" *@>
            </div>
            <nav class="header-tabs">
            </nav>
            <div class="header-actions">
                    <div class="header-user">
                        <span>@fullName</span>
                    </div>
                    <div class="header-avatar">@avatar</div>
            </div>
        </header>

        <!-- Page content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
