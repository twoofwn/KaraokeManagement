@model KaraokeManagement.Models.RoomType
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Room Type" : "Add Room Type";
    ViewData["ActiveNav"] = "roomtypes";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Room Type" : "Add Room Type")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin/RoomTypes">Room Types</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Edit" : "Create New")</span>
        </nav>
    </div>
</div>

<div class="form-layout-narrow">
    <div class="form-card">
        <form method="post"
              asp-action="@(isEdit ? "RoomTypeEdit" : "RoomTypeCreate")"
              asp-controller="Admin"
              asp-route-id="@(isEdit ? Model.RoomTypeId : 0)">

            <div class="field-group" style="margin-bottom:24px;">
                <label class="field-label">Type Name</label>
                <input asp-for="TypeName" class="field-input" placeholder="e.g. Phòng VIP, Phòng Thường..." />
                <span asp-validation-for="TypeName" class="field-error"></span>
            </div>

            <div class="field-group" style="margin-bottom:24px;">
                <label class="field-label">Price / Hour (VNĐ)</label>
                <div class="input-prefix-wrapper">
                    <span class="input-prefix">₫</span>
                    <input asp-for="PricePerHour" type="number" class="field-input has-prefix"
                           placeholder="0" min="0" step="10000" />
                </div>
                <span asp-validation-for="PricePerHour" class="field-error"></span>
                <span class="field-hint">Giá thuê phòng tính theo giờ.</span>
            </div>

            <div class="field-group" style="margin-bottom:28px;">
                <label class="field-label">Description</label>
                <input asp-for="Description" class="field-input" placeholder="Mô tả ngắn về loại phòng..." />
            </div>

            <div class="form-actions">
                <a href="/Admin/RoomTypes" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(isEdit ? "Update Room Type" : "Save Room Type")
                </button>
            </div>
        </form>
    </div>
</div>
