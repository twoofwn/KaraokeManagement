@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Entry" : "Create New Entry";
    ViewData["ActiveNav"] = "inventory";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Entry" : "Create New Entry")</h1>
        <nav class="breadcrumb-nav">
            <a href="/Admin/Index">Inventory</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">@(isEdit ? "Edit" : "Create New")</span>
        </nav>
    </div>
</div>

<div class="form-layout">

    <!-- Left: Main form -->
    <div class="form-main">
        <div class="form-card">
            <form id="entryForm" enctype="multipart/form-data">

                <div class="form-row-2">
                    <!-- Text input -->
                    <div class="field-group">
                        <label class="field-label">Product Name</label>
                        <input type="text"
                               name="ProductName"
                               class="field-input"
                               placeholder="Enter product name"
                               value="@(isEdit ? "Heineken" : "")" />
                    </div>

                    <!-- Number input -->
                    <div class="field-group">
                        <label class="field-label">SKU Number</label>
                        <input type="number"
                               name="SkuNumber"
                               class="field-input"
                               placeholder="0000"
                               min="0"
                               value="@(isEdit ? "1001" : "")" />
                    </div>
                </div>

                <div class="form-row-2">
                    <!-- Select input -->
                    <div class="field-group">
                        <label class="field-label">Category</label>
                        <div class="select-wrapper">
                            <select name="CategoryId" class="field-select" id="categorySelect">
                                <option value="">Select category</option>
                                <option value="1">Bia</option>
                                <option value="2">Rượu</option>
                                <option value="3">Nước Khát</option>
                                <option value="4">Đồ Ăn</option>
                                <option value="5">Trái Cây</option>
                                <option value="6">Combo</option>
                            </select>
                            <i class="fa-solid fa-chevron-down select-arrow"></i>
                        </div>
                    </div>

                    <!-- Number with prefix -->
                    <div class="field-group">
                        <label class="field-label">Price</label>
                        <div class="input-prefix-wrapper">
                            <span class="input-prefix">$</span>
                            <input type="number"
                                   name="Price"
                                   class="field-input has-prefix"
                                   placeholder="0.00"
                                   min="0"
                                   step="0.01"
                                   value="@(isEdit ? "40000" : "")" />
                        </div>
                    </div>
                </div>

                <!-- Textarea -->
                <div class="field-group">
                    <label class="field-label">Description</label>
                    <textarea name="Description"
                              class="field-textarea"
                              placeholder="Detailed product description...">@(isEdit ? "Bia Heineken lon 330ml, nhập khẩu Hà Lan." : "")</textarea>
                </div>

                <div class="form-actions">
                    <a href="/Admin" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Entry
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- Right: Image + Statistics -->
    <div class="form-aside">

        <!-- Featured Image -->
        <div class="aside-card">
            <h3 class="aside-title">Featured Image</h3>

            <div class="upload-zone" id="uploadZone">
                <input type="file"
                       id="fileInput"
                       name="FeaturedImage"
                       accept="image/jpeg,image/png"
                       class="upload-input" />
                <div class="upload-preview" id="uploadPreview">
                    <div class="upload-placeholder" id="uploadPlaceholder">
                        <div class="upload-icon-wrap">
                            <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                        </div>
                        <p class="upload-text">Click or drag file to upload</p>
                        <p class="upload-hint">Supports: JPG, PNG (Max 5MB)</p>
                    </div>
                    <img id="previewImg" src="" alt="Preview" class="upload-img-preview d-none" />
                </div>
            </div>

            <div class="file-info" id="fileInfo">
                <i class="fa-regular fa-image file-info-icon"></i>
                <div>
                    <div class="file-info-name" id="fileName">No file selected</div>
                    <div class="file-info-size" id="fileSize">0 KB</div>
                </div>
            </div>
        </div>

        <!-- Entry Statistics -->
        <div class="aside-card">
            <h3 class="aside-title-sm">ENTRY STATISTICS</h3>
            <div class="stat-row">
                <span class="stat-row-label">Status</span>
                <span class="badge-status draft" id="statusBadge">Draft</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">Last Modified</span>
                <span class="stat-row-value" id="lastModified">Not yet saved</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">Visibility</span>
                <span class="stat-row-value">
                    <i class="fa-solid fa-circle-dot" style="color:#E83C91;font-size:10px;"></i>
                    Public
                </span>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // Pre-select category when editing
    @if (isEdit) {
        <text>document.getElementById('categorySelect').value = '1';</text>
    }

    const fileInput = document.getElementById('fileInput');
    const uploadZone = document.getElementById('uploadZone');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
    const previewImg = document.getElementById('previewImg');
    const fileName = document.getElementById('fileName');
    const fileSize = document.getElementById('fileSize');
    const statusBadge = document.getElementById('statusBadge');
    const lastModified = document.getElementById('lastModified');

    uploadZone.addEventListener('click', () => fileInput.click());

    uploadZone.addEventListener('dragover', e => {
        e.preventDefault();
        uploadZone.classList.add('drag-over');
    });

    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));

    uploadZone.addEventListener('drop', e => {
        e.preventDefault();
        uploadZone.classList.remove('drag-over');
        if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });

    fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) handleFile(fileInput.files[0]);
    });

    function handleFile(file) {
        if (!['image/jpeg', 'image/png'].includes(file.type)) return;
        if (file.size > 5 * 1024 * 1024) return;

        const reader = new FileReader();
        reader.onload = e => {
            previewImg.src = e.target.result;
            previewImg.classList.remove('d-none');
            uploadPlaceholder.classList.add('d-none');
        };
        reader.readAsDataURL(file);

        fileName.textContent = file.name;
        fileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
    }

    document.getElementById('entryForm').addEventListener('submit', e => {
        e.preventDefault();
        statusBadge.textContent = 'Saved';
        statusBadge.className = 'badge-status active';
        const now = new Date();
        lastModified.textContent = now.toLocaleString('vi-VN');
    });
</script>
}
