<div id="adminActionModal" class="admin-modal" hidden aria-hidden="true">
    <div class="admin-modal-backdrop" data-admin-action-close></div>
    <div class="admin-modal-card admin-modal-card-sm"
         role="dialog"
         aria-modal="true"
         aria-labelledby="adminActionTitle">
        <button type="button"
                class="admin-modal-close"
                data-admin-action-close
                aria-label="Đóng">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div id="adminActionIcon" class="admin-modal-icon primary">
            <i class="fa-solid fa-circle-question"></i>
        </div>
        <h3 id="adminActionTitle" class="admin-modal-title">Xác nhận thao tác</h3>
        <p id="adminActionMessage" class="admin-modal-message"></p>

        <div class="admin-modal-actions">
            <button type="button"
                    id="adminActionCancel"
                    class="admin-modal-btn secondary"
                    data-admin-action-close>
                Hủy
            </button>
            <button type="button" id="adminActionConfirm" class="admin-modal-btn primary">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<div id="adminPasswordModal" class="admin-modal" hidden aria-hidden="true">
    <div class="admin-modal-backdrop" data-admin-password-close></div>
    <div class="admin-modal-card"
         role="dialog"
         aria-modal="true"
         aria-labelledby="adminPasswordTitle">
        <button type="button"
                class="admin-modal-close"
                data-admin-password-close
                aria-label="Đóng">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="admin-modal-icon security">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h3 id="adminPasswordTitle" class="admin-modal-title">Xác nhận quyền Admin</h3>
        <p id="adminPasswordMessage" class="admin-modal-message">
            Nhập mật khẩu của tài khoản đang đăng nhập để tiếp tục thao tác.
        </p>

        <form id="adminPasswordForm">
            @Html.AntiForgeryToken()
            <label for="adminPasswordInput" class="admin-modal-label">Mật khẩu Admin</label>
            <div class="admin-password-control">
                <i class="fa-solid fa-lock"></i>
                <input id="adminPasswordInput"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Nhập mật khẩu của bạn" />
                <button type="button"
                        id="adminPasswordToggle"
                        aria-label="Hiện hoặc ẩn mật khẩu">
                    <i class="fa-regular fa-eye"></i>
                </button>
            </div>
            <div id="adminPasswordError" class="admin-modal-error" hidden></div>

            <div class="admin-modal-actions">
                <button type="button"
                        class="admin-modal-btn secondary"
                        data-admin-password-close>
                    Hủy
                </button>
                <button type="submit" id="adminPasswordConfirm" class="admin-modal-btn primary">
                    <span class="button-label">Xác nhận</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (() => {
        const actionModal = document.getElementById('adminActionModal');
        const actionIcon = document.getElementById('adminActionIcon');
        const actionTitle = document.getElementById('adminActionTitle');
        const actionMessage = document.getElementById('adminActionMessage');
        const actionCancel = document.getElementById('adminActionCancel');
        const actionConfirm = document.getElementById('adminActionConfirm');

        const passwordModal = document.getElementById('adminPasswordModal');
        const passwordTitle = document.getElementById('adminPasswordTitle');
        const passwordMessage = document.getElementById('adminPasswordMessage');
        const passwordForm = document.getElementById('adminPasswordForm');
        const passwordInput = document.getElementById('adminPasswordInput');
        const passwordToggle = document.getElementById('adminPasswordToggle');
        const passwordError = document.getElementById('adminPasswordError');
        const passwordConfirm = document.getElementById('adminPasswordConfirm');

        const variants = {
            primary: {
                icon: 'fa-solid fa-circle-question',
                buttonText: 'Xác nhận'
            },
            danger: {
                icon: 'fa-solid fa-triangle-exclamation',
                buttonText: 'Xóa'
            },
            success: {
                icon: 'fa-solid fa-circle-check',
                buttonText: 'Đồng ý'
            },
            warning: {
                icon: 'fa-solid fa-circle-exclamation',
                buttonText: 'Tiếp tục'
            }
        };

        let actionResolver = null;
        let passwordResolver = null;
        let passwordRequestRunning = false;

        function setModalVisibility(modal, visible) {
            modal.hidden = !visible;
            modal.setAttribute('aria-hidden', visible ? 'false' : 'true');
            document.body.classList.toggle(
                'admin-modal-open',
                !actionModal.hidden || !passwordModal.hidden
            );
        }

        function openAction(options = {}) {
            const variantName = variants[options.variant] ? options.variant : 'primary';
            const variant = variants[variantName];

            actionTitle.textContent = options.title || 'Xác nhận thao tác';
            actionMessage.textContent = options.message || '';
            actionConfirm.textContent = options.confirmText || variant.buttonText;
            actionConfirm.className = `admin-modal-btn ${variantName}`;
            actionIcon.className = `admin-modal-icon ${variantName}`;
            actionIcon.innerHTML = `<i class="${options.icon || variant.icon}"></i>`;
            actionCancel.hidden = options.showCancel === false;

            setModalVisibility(actionModal, true);
            actionConfirm.focus();

            return new Promise(resolve => {
                actionResolver = resolve;
            });
        }

        function closeAction(result) {
            setModalVisibility(actionModal, false);
            const resolver = actionResolver;
            actionResolver = null;
            resolver?.(result);
        }

        function showPasswordError(message) {
            passwordError.textContent = message;
            passwordError.hidden = false;
        }

        function openPassword(options = {}) {
            passwordTitle.textContent = options.title || 'Xác nhận quyền Admin';
            passwordMessage.textContent = options.message ||
                'Nhập mật khẩu của tài khoản đang đăng nhập để tiếp tục thao tác.';
            passwordForm.reset();
            passwordInput.type = 'password';
            passwordToggle.innerHTML = '<i class="fa-regular fa-eye"></i>';
            passwordError.hidden = true;
            passwordError.textContent = '';
            passwordConfirm.disabled = false;
            passwordConfirm.classList.remove('loading');
            passwordConfirm.querySelector('.button-label').textContent = 'Xác nhận';

            setModalVisibility(passwordModal, true);
            window.setTimeout(() => passwordInput.focus(), 50);

            return new Promise(resolve => {
                passwordResolver = resolve;
            });
        }

        function closePassword(result) {
            if (passwordRequestRunning) return;

            setModalVisibility(passwordModal, false);
            const resolver = passwordResolver;
            passwordResolver = null;
            resolver?.(result);
        }

        actionConfirm.addEventListener('click', () => closeAction(true));

        document.querySelectorAll('[data-admin-action-close]').forEach(element => {
            element.addEventListener('click', () => closeAction(false));
        });

        document.querySelectorAll('[data-admin-password-close]').forEach(element => {
            element.addEventListener('click', () => closePassword(null));
        });

        passwordToggle.addEventListener('click', () => {
            const shouldShow = passwordInput.type === 'password';
            passwordInput.type = shouldShow ? 'text' : 'password';
            passwordToggle.innerHTML = shouldShow
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';
            passwordInput.focus();
        });

        passwordForm.addEventListener('submit', async event => {
            event.preventDefault();

            const password = passwordInput.value;
            if (password.trim() === '') {
                showPasswordError('Vui lòng nhập mật khẩu Admin.');
                passwordInput.focus();
                return;
            }

            passwordError.hidden = true;
            passwordRequestRunning = true;
            passwordConfirm.disabled = true;
            passwordConfirm.classList.add('loading');
            passwordConfirm.querySelector('.button-label').textContent = 'Đang xác nhận...';

            try {
                const token = passwordForm.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;
                const response = await fetch('/Admin/VerifyAdminPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams({
                        password,
                        __RequestVerificationToken: token
                    })
                });
                const data = await response.json();

                if (data.success) {
                    passwordRequestRunning = false;
                    setModalVisibility(passwordModal, false);
                    const resolver = passwordResolver;
                    passwordResolver = null;
                    resolver?.(true);
                    return;
                }

                showPasswordError(data.message || 'Mật khẩu Admin không chính xác.');
                passwordInput.select();
            } catch (error) {
                console.error('Admin password verification failed:', error);
                showPasswordError('Không thể xác nhận mật khẩu. Vui lòng thử lại.');
            } finally {
                passwordRequestRunning = false;
                passwordConfirm.disabled = false;
                passwordConfirm.classList.remove('loading');
                passwordConfirm.querySelector('.button-label').textContent = 'Xác nhận';
            }
        });

        document.addEventListener('keydown', event => {
            if (event.key !== 'Escape') return;

            if (!passwordModal.hidden) {
                closePassword(null);
            } else if (!actionModal.hidden) {
                closeAction(false);
            }
        });

        document.addEventListener('submit', async event => {
            const form = event.target.closest('form[data-admin-confirm]');
            if (!form || form.dataset.adminConfirmed === 'true') {
                return;
            }

            event.preventDefault();
            const confirmed = await openAction({
                title: form.dataset.adminConfirmTitle,
                message: form.dataset.adminConfirm,
                confirmText: form.dataset.adminConfirmButton,
                variant: form.dataset.adminConfirmVariant || 'danger',
                icon: form.dataset.adminConfirmIcon
            });

            if (!confirmed) return;

            form.dataset.adminConfirmed = 'true';
            HTMLFormElement.prototype.submit.call(form);
        });

        window.AdminPopup = {
            confirm(options) {
                return openAction({ ...options, showCancel: true });
            },
            async alert(options) {
                await openAction({
                    ...options,
                    showCancel: false,
                    confirmText: options?.confirmText || 'Đã hiểu'
                });
            },
            verifyPassword(options) {
                return openPassword(options);
            }
        };
    })();
</script>
