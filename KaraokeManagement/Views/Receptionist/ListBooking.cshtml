@model KaraokeManagement.ViewModel.ListBookingViewModel
@{
    Layout = null;
}
@using System.Security.Claims
@using KaraokeManagement.Models
@{
    var cancellationReasons = ViewBag.CancellationReasons as List<CancellationReason> ?? new List<CancellationReason>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Danh sách đặt phòng - Minh Tuấn Karaoke</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/InvoiceHistory.css" asp-append-version="true" />
</head>
<body class="invoice-history-page">
    <partial name="_ReceptionistLayout" />

    <div class="reception-main">
        <form id="bookingForm" method="get" action="/Receptionist/ListBooking" style="display: contents;">
            <input type="hidden" name="page" id="pageNumberInput" value="@Model.CurrentPage" />

            <header class="reception-header">
                <div class="header-title-wrapper" style="margin-left: 0; display: flex; align-items: center; gap: 16px; flex-grow: 1;">
                    <h1 class="header-title-text" style="font-size: 1.5rem; font-weight: 800; margin: 0;">Danh sách đặt phòng</h1>
                </div>

                <div class="header-actions">
                    <div class="user-profile">
                        <span class="user-name">@(User.Identity?.Name ?? "Chưa rõ")</span>
                    </div>
                </div>
            </header>

            <main class="history-container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 12px 16px; margin-bottom: 16px; background-color: #D1FAE5; color: #065F46; border-radius: 8px; font-weight: 500;">
                        <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 12px 16px; margin-bottom: 16px; background-color: #FEE2E2; color: #991B1B; border-radius: 8px; font-weight: 500;">
                        <i class="fa-solid fa-triangle-exclamation" style="margin-right: 8px;"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <div class="history-card">
                    <h2 class="card-title">
                        <i class="fa-solid fa-magnifying-glass"></i> BỘ LỌC TÌM KIẾM
                    </h2>

                    <div class="filter-grid">
                        <div class="filter-input-group">
                            <label>Khách hàng / Số điện thoại</label>
                            <input type="text" name="customerFilter" value="@Model.CustomerFilter" placeholder="Tìm theo tên hoặc SĐT..." class="filter-control" autocomplete="off" />
                        </div>

                        <div class="filter-input-group">
                            <label>Thời gian đặt</label>
                            <select name="dateRange" class="filter-control">
                                <option value="all" selected="@(Model.DateRange == "all" ? "selected" : null)">Tất cả thời gian</option>
                                <option value="3days" selected="@(Model.DateRange == "3days" ? "selected" : null)">3 ngày gần đây</option>
                                <option value="7days" selected="@(Model.DateRange == "7days" ? "selected" : null)">7 ngày gần đây</option>
                                <option value="30days" selected="@(Model.DateRange == "30days" ? "selected" : null)">1 tháng gần đây</option>
                            </select>
                        </div>
                    </div>

                    <div class="filter-actions">
                        <button type="button" class="btn-filter btn-filter-reset" onclick="resetFilters()">
                            <i class="fa-solid fa-rotate-right"></i> Đặt lại
                        </button>
                        <button type="button" class="btn-filter btn-filter-search" onclick="submitForm(1)">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>

                <div class="history-card">
                    <h2 class="card-title">
                        <i class="fa-solid fa-calendar-check"></i> Danh sách Đặt Phòng
                    </h2>

                    <div class="history-table-container">
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>TÊN PHÒNG</th>
                                    <th>KHÁCH HÀNG</th>
                                    <th>SỐ ĐIỆN THOẠI</th>
                                    <th>THỜI GIAN BẮT ĐẦU</th>
                                    <th>THỜI GIAN KẾT THÚC</th>
                                    <th style="text-align: center;">SỐ NGUỜI</th>
                                    <th>GHI CHÚ</th>
                                    <th style="text-align: center;">TRẠNG THÁI</th>
                                    <th style="text-align: center; width: 100px;">HÀNH ĐỘNG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                }
                                @if (Model.Bookings != null && Model.Bookings.Any())
                                {
                                    @foreach (var booking in Model.Bookings)
                                    {
                                        <tr>
                                            <td class="col-invoice-code">@((index++).ToString("D3"))</td>

                                            <td>
                                                <span class="badge-room">@booking.RoomName</span>
                                            </td>

                                            <td>
                                                <div class="customer-name">@booking.CustomerName</div>
                                            </td>

                                            <td class="customer-phone">
                                                @(string.IsNullOrEmpty(booking.CustomerPhone) ? "--" : booking.CustomerPhone)
                                            </td>

                                            <td>
                                                <div class="time-entry-row">
                                                    <span class="status-dot in"></span>
                                                    <span>@booking.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            </td>

                                            <td>
                                                <div class="time-entry-row">
                                                    <span class="status-dot out"></span>
                                                    <span>@(booking.EndTime.HasValue? booking.EndTime.Value.ToString("dd/MM/yyyy HH:mm") : "--:--")</span>
                                                </div>
                                            </td>

                                            <td style="text-align: center;">
                                                @(booking.GuestCount.HasValue? booking.GuestCount.Value.ToString() : "--")
                                            </td>

                                            <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@booking.Note">
                                                @(string.IsNullOrEmpty(booking.Note) ? "--" : booking.Note)
                                            </td>

                                            <td style="text-align: center;">
                                                @if (booking.Status == "Pending")
                                                {
                                                    <span class="badge-status pending">Chờ xử lý</span>
                                                }
                                                else if (booking.Status == "Confirmed")
                                                {
                                                    <span class="badge-status confirmed">Đã xác nhận</span>
                                                }
                                                else if (booking.Status == "Cancelled")
                                                {
                                                    <span class="badge-status cancelled">Đã hủy</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-status">@booking.Status</span>
                                                }
                                            </td>

                                            <td style="display: flex; align-items: center; gap: 6px;">
                                                @if (booking.Status == "Pending")
                                                {
                                                    <button type="button" class="btn-action btn-confirm" onclick="updateBookingStatus(@booking.BookingId, 'Confirmed')" title="Xác nhận Booking">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                    <button type="button" class="btn-action btn-cancel-booking" onclick="openCancellationDialog(@booking.BookingId)" title="Hủy Booking">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--text-muted); font-size: 0.85rem;">--</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="empty-table-state">
                                            <i class="fa-solid fa-folder-open"></i>
                                            <p>Không tìm thấy thông tin đặt phòng nào phù hợp.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <div class="pagination-container">
                            <ul class="pagination-list">
                                <li>
                                    <button type="button" class="page-item-link @(Model.CurrentPage == 1 ? "disabled" : "")"
                                            onclick="submitForm(@(Model.CurrentPage - 1))" aria-label="Previous page">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li>
                                        <button type="button" class="page-item-link @(Model.CurrentPage == i ? "active" : "")"
                                                onclick="submitForm(@i)">
                                            @i
                                        </button>
                                    </li>
                                }

                                <li>
                                    <button type="button" class="page-item-link @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
                                            onclick="submitForm(@(Model.CurrentPage + 1))" aria-label="Next page">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </main>
        </form>
    </div>

    <dialog id="cancellationDialog" class="cancellation-dialog">
        <div class="cancellation-dialog-header">
            <div>
                <strong>Hủy đơn đặt phòng</strong>
                <div id="cancellationBookingCode" class="cancellation-dialog-code"></div>
            </div>
            <button type="button" class="cancellation-dialog-close" onclick="closeCancellationDialog()" aria-label="Đóng">&times;</button>
        </div>
        <div class="cancellation-dialog-body">
            <label for="cancellationReasonId">Lý do hủy <span class="required">*</span></label>
            <select id="cancellationReasonId" onchange="toggleCancellationDetail()" required>
                <option value="">-- Chọn lý do hủy --</option>
                @foreach (var reason in cancellationReasons)
                {
                    <option value="@reason.CancellationReasonId"
                            data-requires-detail="@reason.RequiresDetail.ToString().ToLowerInvariant()">
                        @reason.ReasonName
                    </option>
                }
            </select>

            <div id="cancellationDetailGroup" hidden>
                <label for="cancellationReasonDetail">Lý do cụ thể <span class="required">*</span></label>
                <textarea id="cancellationReasonDetail" maxlength="500" rows="4"
                          placeholder="Nhập lý do hủy phòng..."></textarea>
                <small>Tối đa 500 ký tự.</small>
            </div>
            <div id="cancellationError" class="cancellation-error" hidden></div>
        </div>
        <div class="cancellation-dialog-actions">
            <button type="button" class="btn-dialog-secondary" onclick="closeCancellationDialog()">Quay lại</button>
            <button type="button" class="btn-dialog-danger" id="submitCancellationButton" onclick="submitCancellation()">
                <i class="fa-solid fa-ban"></i> Xác nhận hủy
            </button>
        </div>
    </dialog>

    <style>
        .cancellation-dialog { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); margin: 0; width: min(520px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow-y: auto; border: 0; border-radius: 18px; padding: 0; box-shadow: 0 24px 70px rgba(31, 21, 46, .25); color: #2b2036; }
        .cancellation-dialog::backdrop { background: rgba(20, 12, 28, .55); backdrop-filter: blur(2px); }
        .cancellation-dialog-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 22px 24px; border-bottom: 1px solid #eee7f1; }
        .cancellation-dialog-header strong { font-size: 1.15rem; }
        .cancellation-dialog-code { color: #7d7185; font-size: .85rem; margin-top: 4px; }
        .cancellation-dialog-close { border: 0; background: transparent; font-size: 1.7rem; line-height: 1; cursor: pointer; color: #74677c; }
        .cancellation-dialog-body { display: grid; gap: 10px; padding: 22px 24px; }
        .cancellation-dialog-body label { font-weight: 700; margin-top: 4px; }
        .cancellation-dialog-body select, .cancellation-dialog-body textarea { width: 100%; box-sizing: border-box; border: 1px solid #d9cfde; border-radius: 10px; padding: 11px 12px; font: inherit; background: white; }
        .cancellation-dialog-body select:focus, .cancellation-dialog-body textarea:focus { outline: 2px solid rgba(182, 0, 86, .18); border-color: #b60056; }
        .cancellation-dialog-body small { color: #7d7185; }
        .required, .cancellation-error { color: #c62828; }
        .cancellation-error { background: #ffebee; border-radius: 8px; padding: 10px 12px; font-size: .9rem; }
        .cancellation-dialog-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px 22px; }
        .btn-dialog-secondary, .btn-dialog-danger { border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; }
        .btn-dialog-secondary { background: #eee9f1; color: #493d50; }
        .btn-dialog-danger { background: #c62828; color: white; }
        .btn-dialog-danger:disabled { opacity: .6; cursor: wait; }
    </style>

    <script>
        let cancellationBookingId = null;

        function submitForm(page) {
            document.getElementById('pageNumberInput').value = page;
            document.getElementById('bookingForm').submit();
        }

        function resetFilters() {
            const form = document.getElementById('bookingForm');

            const quickSearch = document.getElementById('quickSearchInput');
            if (quickSearch) quickSearch.value = '';

            const customer = form.querySelector('input[name="customerFilter"]');
            if (customer) customer.value = '';

            const dateRange = form.querySelector('select[name="dateRange"]');
            if (dateRange) dateRange.value = 'all';

            const status = form.querySelector('select[name="status"]');
            if (status) status.value = 'Pending';

            submitForm(1);
        }

        function updateBookingStatus(bookingId, status) {
            if (!confirm(`Bạn có chắc chắn muốn XÁC NHẬN đơn đặt phòng #BK-${String(bookingId).padStart(4, '0')}?`)) {
                return;
            }

            fetch('/Receptionist/UpdateBookingStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ bookingId: bookingId, status: status })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Có lỗi xảy ra khi gửi yêu cầu.');
            });
        }

        function openCancellationDialog(bookingId) {
            cancellationBookingId = bookingId;
            document.getElementById('cancellationBookingCode').textContent =
                `Đơn #BK-${String(bookingId).padStart(4, '0')}`;
            document.getElementById('cancellationReasonId').value = '';
            document.getElementById('cancellationReasonDetail').value = '';
            document.getElementById('cancellationError').hidden = true;
            toggleCancellationDetail();
            document.getElementById('cancellationDialog').showModal();
        }

        function closeCancellationDialog() {
            document.getElementById('cancellationDialog').close();
            cancellationBookingId = null;
        }

        function toggleCancellationDetail() {
            const select = document.getElementById('cancellationReasonId');
            const option = select.options[select.selectedIndex];
            const requiresDetail = option?.dataset.requiresDetail === 'true';
            const group = document.getElementById('cancellationDetailGroup');
            const detail = document.getElementById('cancellationReasonDetail');
            group.hidden = !requiresDetail;
            detail.required = requiresDetail;
            if (!requiresDetail) detail.value = '';
        }

        async function submitCancellation() {
            const reasonId = Number(document.getElementById('cancellationReasonId').value);
            const detail = document.getElementById('cancellationReasonDetail').value.trim();
            const select = document.getElementById('cancellationReasonId');
            const requiresDetail = select.options[select.selectedIndex]?.dataset.requiresDetail === 'true';
            const errorBox = document.getElementById('cancellationError');

            if (!reasonId || (requiresDetail && !detail)) {
                errorBox.textContent = !reasonId ? 'Vui lòng chọn lý do hủy.' : 'Vui lòng nhập lý do hủy cụ thể.';
                errorBox.hidden = false;
                return;
            }

            const button = document.getElementById('submitCancellationButton');
            button.disabled = true;
            errorBox.hidden = true;

            try {
                const response = await fetch('/Receptionist/UpdateBookingStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bookingId: cancellationBookingId,
                        status: 'Cancelled',
                        cancellationReasonId: reasonId,
                        cancellationReasonDetail: detail
                    })
                });
                const data = await response.json();
                if (!data.success) throw new Error(data.message || 'Không thể hủy đơn đặt phòng.');
                location.reload();
            } catch (error) {
                errorBox.textContent = error.message || 'Có lỗi xảy ra khi gửi yêu cầu.';
                errorBox.hidden = false;
                button.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const quickSearch = document.getElementById('quickSearchInput');
            let timeout = null;
            if (quickSearch) {
                quickSearch.addEventListener('input', () => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        submitForm(1);
                    }, 800);
                });

                if (quickSearch.value) {
                    quickSearch.focus();
                    quickSearch.setSelectionRange(quickSearch.value.length, quickSearch.value.length);
                }
            }
        });
    </script>
</body>
</html>
