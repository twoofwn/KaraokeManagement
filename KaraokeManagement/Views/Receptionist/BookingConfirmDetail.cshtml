@model KaraokeManagement.ViewModel.CheckInDetailViewModel
@{
    Layout = null;
}
@using KaraokeManagement.Models
@{
    var cancellationReasons = ViewBag.CancellationReasons as List<CancellationReason> ?? new List<CancellationReason>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chi Tiết Nhận Phòng - Minh Tuấn Karaoke</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CheckIn.css" asp-append-version="true" />
 
</head>
<body class="invoice-history-page">
    <partial name="_ReceptionistLayout" />

    <div class="reception-main">
        <header class="reception-header">
            <div class="header-title-wrapper" style="margin-left: 0; display: flex; align-items: center; gap: 16px; flex-grow: 1;">
                <h1 class="header-title-text" style="font-size: 1.5rem; font-weight: 800; margin: 0;">Chi Tiết Đặt Phòng & Check-in</h1>
            </div>

            <div class="header-actions">
                <div class="user-profile">
                    <span class="user-name">@(User.Identity?.Name ?? "Chưa rõ")</span>
                </div>
            </div>
        </header>

        <main class="history-container" style="padding-top: 10px; overflow-y: auto; height: calc(100vh - 80px); margin: 0 25px;">
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="validation-alert" style="display: block;">
                    <i class="fa-solid fa-triangle-exclamation" style="margin-right: 8px;"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Receptionist" asp-action="ConfirmCheckIn" method="post" id="confirmCheckInForm">
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="CurrentRoomId" />

                <div class="detail-grid">


                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        
                        <div class="checkin-card">
                            <div class="checkin-card-title">
                                <i class="fa-solid fa-user-pen"></i>
                                <span>Thông tin Khách Hàng</span>
                            </div>
                            
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div class="form-group">
                                    <label class="info-label" for="CustomerName"><i class="fa-solid fa-signature"></i> Họ và tên</label>
                                    <input type="text" readonly asp-for="CustomerName" class="form-input" required />
                                </div>
                                <div class="form-group">
                                    <label class="info-label" for="Phone"><i class="fa-solid fa-phone"></i> Số điện thoại</label>
                                    <input type="text" readonly asp-for="Phone" class="form-input" required />
                                </div>
                                <div class="form-group" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="info-label" for="Email"><i class="fa-solid fa-envelope"></i> Email</label>
                                    <input type="email" readonly asp-for="Email" class="form-input" />
                                </div>
                            </div>
                        </div>

                        <!-- Dat phong -->
                        <div class="checkin-card">
                            <div class="checkin-card-title">
                                <i class="fa-solid fa-calendar-days"></i>
                                <span>Thông tin đặt lịch trước</span>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div class="info-group">
                                    <span class="info-label"><i class="fa-solid fa-clock"></i> Giờ nhận dự kiến</span>
                                    <div class="info-value">@Model.StartTime.ToString("HH:mm - dd/MM/yyyy")</div>
                                </div>
                                <div class="info-group">
                                    <span class="info-label"><i class="fa-solid fa-clock"></i> Giờ trả dự kiến</span>
                                    <div class="info-value">@(Model.EndTime.HasValue ? Model.EndTime.Value.ToString("HH:mm - dd/MM/yyyy") : "--")</div>
                                </div>
                                <div class="form-group">
                                    <label class="info-label" for="GuestCount"><i class="fa-solid fa-users"></i> Số khách</label>
                                    <input type="number" asp-for="GuestCount" class="form-input" min="1" required />
                                </div>
                                <div class="info-group">
                                    <span class="info-label"><i class="fa-solid fa-circle-info"></i> Trạng thái</span>
                                    <div style="margin-top: 2px;">
                                        <span class="badge-info-status confirmed">
                                            <i class="fa-solid fa-circle-check"></i> @Model.Status
                                        </span>
                                    </div>
                                </div>
                                <div class="form-group" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="info-label" for="Note"><i class="fa-solid fa-note-sticky"></i> Ghi chú đặt phòng</label>
                                    <textarea asp-for="Note" class="form-input" style="min-height: 70px; resize: vertical;"></textarea>
                                </div>
                            </div>
                        </div>

                    </div>




                    <div>
                        
                        <div class="checkin-card">
                            <div class="checkin-card-title">
                                <i class="fa-solid fa-door-open"></i>
                                <span>Thông Tin Phòng & Phục Vụ</span>
                            </div>

                            <!-- thong tin phong -->
                            <div class="room-current-box">
                                @if (!string.IsNullOrEmpty(Model.CurrentRoomTypeImageUrl))
                                {
                                    <div class="room-image-wrapper" style="width: 100%; height: 100%; margin-bottom: 12px; border-radius: 8px; overflow: hidden; border: 1px solid #EADADF;">
                                        <img src="@Model.CurrentRoomTypeImageUrl" alt="@Model.CurrentRoomTypeName" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="room-image-wrapper" style="width: 100%; height: 160px; margin-bottom: 12px; border-radius: 8px; overflow: hidden; border: 1px solid #EADADF; background-color: #FAFAFB; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                                        <i class="fa-solid fa-image" style="font-size: 2.5rem; color: #E6D4D8;"></i>
                                    </div>
                                }

                                <!-- Khối thông tin dạt sang 2 bên -->
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <!-- Bên trái: Tên phòng -->
                                    <div>
                                        <span class="info-label" style="color: var(--primary-magenta); font-weight: 700; display: block; margin-bottom: 2px;">Phòng đã đặt</span>
                                        <div class="room-current-title">
                                            <i class="fa-solid fa-microphone-lines"></i> @Model.CurrentRoomName
                                        </div>
                                    </div>

                                    <!-- Bên phải: Loại phòng & Giá -->
                                    <div style="text-align: right;">
                                        <div style="font-size: 0.85rem; color: var(--text-secondary-dark);">
                                            <p style="margin: 0;">Loại phòng: <strong>@Model.CurrentRoomTypeName</strong></p>
                                            <p style="margin: 2px 0 0 0;">Giá phòng: <strong style="color: #DC2626;">@(Model.CurrentPricePerHour.ToString("N0"))đ/giờ</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Doi phong -->
                            <div class="form-group">
                                <label class="form-label" for="SelectedNewRoomId">Đổi sang phòng khác (Nếu cần)</label>
                                <select asp-for="SelectedNewRoomId" class="form-input" style="background-color: white;">
                                    <option value="@Model.CurrentRoomId">-- Giữ nguyên phòng đã đặt (@Model.CurrentRoomName) --</option>
                                    @if (Model.AvailableRoomsToSwitch != null && Model.AvailableRoomsToSwitch.Any())
                                    {
                                        @foreach (var room in Model.AvailableRoomsToSwitch.Where(r => r.RoomId != Model.CurrentRoomId))
                                        {
                                            <option value="@room.RoomId">
                                                @room.RoomName - @room.TypeName (@(room.PricePerHour.ToString("N0"))đ/giờ)
                                            </option>
                                        }
                                    }
                                </select>
                                <small style="display: block; margin-top: 4px; color: var(--text-secondary); font-size: 0.725rem;">
                                    * Chỉ hiển thị phòng trống không trùng lịch ở cùng khung giờ.
                                </small>
                            </div>

                            <!-- Nhan vien  -->
                            <div class="form-group">
                                <label class="form-label" for="SelectedStaffId">Nhân viên phục vụ phòng</label>
                                <select required asp-for="SelectedStaffId" class="form-input" style="background-color: white;">
                                    <option value="">-- Chọn nhân viên phục vụ --</option>
                                    @if (Model.EligibleStaffs != null && Model.EligibleStaffs.Any())
                                    {
                                        @foreach (var staff in Model.EligibleStaffs)
                                        {
                                            <option value="@staff.AccountId">
                                                @staff.FullName (@staff.ShiftInfo)
                                            </option>
                                        }
                                    }
                                </select>
                                <small style="display: block; margin-top: 4px; color: var(--text-secondary); font-size: 0.725rem;">
                                    * Ưu tiên hiển thị các nhân viên có ca trực trùng khung giờ này.
                                </small>
                            </div>

                            <div class="action-buttons-container">
                                <button type="submit" class="btn-confirm-booking">
                                    <i class="fa-solid fa-circle-check"></i> Xác nhận nhận phòng (Check-in)
                                </button>
                                
                                <button type="button" class="btn-cancel-booking" onclick="document.getElementById('cancellationDialog').showModal()">
                                    <i class="fa-solid fa-trash-can"></i> Hủy đơn đặt lịch
                                </button>
                            </div>

                            <div style="margin-top: 20px; border-top: 1px solid var(--border-color-soft); padding-top: 12px;">
                                <a href="/Receptionist/BookingConfirm" class="btn-back" style="width: 100%;">
                                    <i class="fa-solid fa-angle-left"></i> Trở về danh sách
                                </a>
                            </div>
                        </div>

                    </div>

                </div>
            </form>

        </main>
    </div>

    <dialog id="cancellationDialog" class="cancellation-dialog">
        <form asp-controller="Receptionist" asp-action="CancelBooking" method="post" id="cancelBookingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" value="@Model.BookingId" />

            <div class="cancellation-dialog-header">
                <div>
                    <strong>Hủy đơn đặt phòng</strong>
                    <div class="cancellation-dialog-code">Đơn #BK-@Model.BookingId.ToString("D4")</div>
                </div>
                <button type="button" class="cancellation-dialog-close" onclick="document.getElementById('cancellationDialog').close()" aria-label="Đóng">&times;</button>
            </div>

            <div class="cancellation-dialog-body">
                <label for="cancellationReasonId">Lý do hủy <span class="required">*</span></label>
                <select name="cancellationReasonId" id="cancellationReasonId" onchange="toggleCancellationDetail()" required>
                    <option value="">-- Chọn lý do hủy --</option>
                    @foreach (var reason in cancellationReasons)
                    {
                        <option value="@reason.CancellationReasonId"
                                data-requires-detail="@reason.RequiresDetail.ToString().ToLowerInvariant()">
                            @reason.ReasonName
                        </option>
                    }
                </select>

                <div id="cancellationDetailGroup" hidden>
                    <label for="cancellationReasonDetail">Lý do cụ thể <span class="required">*</span></label>
                    <textarea name="cancellationReasonDetail" id="cancellationReasonDetail" maxlength="500" rows="4"
                              placeholder="Nhập lý do hủy phòng..."></textarea>
                    <small>Tối đa 500 ký tự.</small>
                </div>
            </div>

            <div class="cancellation-dialog-actions">
                <button type="button" class="btn-dialog-secondary" onclick="document.getElementById('cancellationDialog').close()">Quay lại</button>
                <button type="submit" class="btn-dialog-danger">
                    <i class="fa-solid fa-ban"></i> Xác nhận hủy
                </button>
            </div>
        </form>
    </dialog>

    <style>
        .cancellation-dialog { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); margin: 0; width: min(520px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow-y: auto; border: 0; border-radius: 18px; padding: 0; box-shadow: 0 24px 70px rgba(31, 21, 46, .25); color: #2b2036; }
        .cancellation-dialog::backdrop { background: rgba(20, 12, 28, .55); backdrop-filter: blur(2px); }
        .cancellation-dialog-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 22px 24px; border-bottom: 1px solid #eee7f1; }
        .cancellation-dialog-header strong { font-size: 1.15rem; }
        .cancellation-dialog-code { color: #7d7185; font-size: .85rem; margin-top: 4px; }
        .cancellation-dialog-close { border: 0; background: transparent; font-size: 1.7rem; line-height: 1; cursor: pointer; color: #74677c; }
        .cancellation-dialog-body { display: grid; gap: 10px; padding: 22px 24px; }
        .cancellation-dialog-body label { font-weight: 700; margin-top: 4px; }
        .cancellation-dialog-body select, .cancellation-dialog-body textarea { width: 100%; box-sizing: border-box; border: 1px solid #d9cfde; border-radius: 10px; padding: 11px 12px; font: inherit; background: white; }
        .cancellation-dialog-body small { color: #7d7185; }
        .required { color: #c62828; }
        .cancellation-dialog-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px 22px; }
        .btn-dialog-secondary, .btn-dialog-danger { border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; }
        .btn-dialog-secondary { background: #eee9f1; color: #493d50; }
        .btn-dialog-danger { background: #c62828; color: white; }
    </style>

    <script>
        function toggleCancellationDetail() {
            const select = document.getElementById('cancellationReasonId');
            const option = select.options[select.selectedIndex];
            const requiresDetail = option?.dataset.requiresDetail === 'true';
            const group = document.getElementById('cancellationDetailGroup');
            const detail = document.getElementById('cancellationReasonDetail');
            group.hidden = !requiresDetail;
            detail.required = requiresDetail;
            if (!requiresDetail) detail.value = '';
        }
    </script>
</body>
</html>
