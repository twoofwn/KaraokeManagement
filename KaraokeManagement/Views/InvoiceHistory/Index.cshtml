@model KaraokeManagement.Models.InvoiceHistoryViewModel
@{
    Layout = null;
}
@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lịch sử hóa đơn - Minh Tuấn KTV</title>
    
    <!-- CSS Dependencies -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/InvoiceHistory.css" asp-append-version="true" />
</head>
<body class="invoice-history-page">
    <!-- Fixed Sidebar on the Left -->
    <partial name="_ReceptionistSidebar" />

    <!-- Main Content Area on the Right -->
    <div class="reception-main">
        <form id="historyForm" method="get" action="/InvoiceHistory" style="display: contents;">
            <!-- Hidden input for pagination page number -->
            <input type="hidden" name="page" id="pageNumberInput" value="@Model.CurrentPage" />

            <!-- Header Section -->
            <header class="reception-header">
                <div class="header-title-wrapper" style="margin-left: 0; display: flex; align-items: center; gap: 16px; flex-grow: 1;">
                    <h1 class="header-title-text" style="font-size: 1.5rem; font-weight: 800; color: var(--primary-magenta); margin: 0;">Lịch sử hóa đơn</h1>
                    
                    <!-- Search bar (Tìm kiếm nhanh) -->
                    <div style="position: relative; width: 280px; margin-left: 10px;">
                        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.85rem;"></i>
                        <input type="text" name="searchString" value="@Model.SearchString" placeholder="Tìm nhanh hóa đơn..." 
                               style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid var(--border-soft); border-radius: 50px; background-color: #FAF4F5; font-size: 0.85rem; outline: none; transition: all 0.2s;" 
                               onkeydown="if(event.key === 'Enter') { submitForm(1); event.preventDefault(); }" autocomplete="off" id="quickSearchInput" />
                    </div>
                </div>

                <div class="header-actions">
                    <div class="user-profile">
                        <div class="avatar-container">
                            <img src="~/img/receptionist_avatar.png" alt="Avatar" class="user-avatar" />
                        </div>
                        <div class="user-info">
                            <span class="user-name">@(User.Identity?.Name ?? "Chưa rõ")</span>
                            <span class="user-role">@(User.FindFirst(ClaimTypes.Role)?.Value ?? "Chưa rõ")</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Scrollable Dashboard Viewport -->
            <main class="history-container">
                
                <!-- CARD 1: CÔNG CỤ TRA CỨU (Filters) -->
                <div class="history-card">
                    <h2 class="card-title">
                        <i class="fa-solid fa-magnifying-glass"></i> CÔNG CỤ TRA CỨU
                    </h2>
                    
                    <div class="filter-grid">
                        <!-- Cột 1: Khách hàng / Số điện thoại -->
                        <div class="filter-input-group">
                            <label>Khách hàng / Số điện thoại</label>
                            <input type="text" name="customerFilter" value="@Model.CustomerFilter" placeholder="Tìm theo tên hoặc SĐT..." class="filter-control" autocomplete="off" />
                        </div>

                        <!-- Cột 2: Từ ngày -->
                        <div class="filter-input-group">
                            <label>Từ ngày</label>
                            <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="filter-control" />
                        </div>

                        <!-- Cột 3: Đến ngày -->
                        <div class="filter-input-group">
                            <label>Đến ngày</label>
                            <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="filter-control" />
                        </div>

                        <!-- Cột 4: Trạng thái -->
                        <div class="filter-input-group">
                            <label>Trạng thái</label>
                            <select name="status" class="filter-control">
                                <option value="All" selected="@(Model.SelectedStatus == "All" ? "selected" : null)">Tất cả</option>
                                <option value="Paid" selected="@(Model.SelectedStatus == "Paid" ? "selected" : null)">Đã thanh toán - Paid</option>
                                <option value="Unpaid" selected="@(Model.SelectedStatus == "Unpaid" ? "selected" : null)">Chưa thanh toán - Unpaid</option>
                            </select>
                        </div>
                    </div>

                    <!-- Bottom Right buttons -->
                    <div class="filter-actions">
                        <button type="button" class="btn-filter btn-filter-reset" onclick="resetFilters()">
                            <i class="fa-solid fa-rotate-right"></i> Đặt lại
                        </button>
                        <button type="button" class="btn-filter btn-filter-search" onclick="submitForm(1)">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>

                <!-- CARD 2: DANH SÁCH GIAO DỊCH (Data Table) -->
                <div class="history-card">
                    <h2 class="card-title">
                        <i class="fa-solid fa-file-invoice"></i> Danh sách giao dịch
                    </h2>
                    
                    <div class="history-table-container">
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>MÃ HD</th>
                                    <th>TÊN PHÒNG</th>
                                    <th>KHÁCH HÀNG</th>
                                    <th>TIẾP TÂN</th>
                                    <th>GIỜ VÀO/RA</th>
                                    <th>TỔNG TIỀN</th>
                                    <th>TRẠNG THÁI</th>
                                    <th style="text-align: center; width: 80px;">HÀNH ĐỘNG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Invoices.Any())
                                {
                                    @foreach (var invoice in Model.Invoices)
                                    {
                                        <tr>
                                            <!-- Cột 1: Mã hóa đơn -->
                                            <td class="col-invoice-code">#LUM-@invoice.InvoiceId.ToString("D4")</td>

                                            <!-- Cột 2: Tên phòng -->
                                            <td>
                                                <span class="badge-room">@invoice.RoomName</span>
                                            </td>

                                            <!-- Cột 3: Khách hàng -->
                                            <td>
                                                <div class="customer-name">@invoice.CustomerName</div>
                                                @if (!string.IsNullOrEmpty(invoice.CustomerPhone))
                                                {
                                                    <div class="customer-phone">@invoice.CustomerPhone</div>
                                                }
                                            </td>

                                            <!-- Cột 4: Tiếp tân -->
                                            <td class="staff-name">@invoice.ReceptionistName</td>

                                            <!-- Cột 5: Giờ vào/ra -->
                                            <td>
                                                <div class="time-entry-row">
                                                    <span class="status-dot in"></span>
                                                    <span>@invoice.CheckInTime.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                <div class="time-entry-row">
                                                    <span class="status-dot out"></span>
                                                    <span>@(invoice.CheckOutTime.HasValue ? invoice.CheckOutTime.Value.ToString("dd/MM/yyyy HH:mm") : "--:--")</span>
                                                </div>
                                            </td>

                                            <!-- Cột 6: Tổng tiền -->
                                            <td class="total-amount-cell">@invoice.TotalAmount.ToString("N0")đ</td>

                                            <!-- Cột 7: Trạng thái -->
                                            <td>
                                                @if (invoice.Status == "Paid")
                                                {
                                                    <span class="badge-status paid">
                                                        <i class="fa-solid fa-circle-check"></i> Đã thanh toán
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge-status unpaid">
                                                        <i class="fa-solid fa-circle-info"></i> Chưa thanh toán
                                                    </span>
                                                }
                                            </td>

                                            <!-- Cột 8: Hành động -->
                                            <td style="text-align: center;">
                                                <button type="button" class="btn-action-view" onclick="viewInvoiceDetail(@invoice.InvoiceId)" title="Xem chi tiết">
                                                    <i class="fa-solid fa-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="empty-table-state">
                                            <i class="fa-solid fa-folder-open"></i>
                                            <p>Không tìm thấy hóa đơn nào phù hợp với bộ lọc tìm kiếm.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="pagination-container">
                            <ul class="pagination-list">
                                <!-- Previous page -->
                                <li>
                                    <button type="button" class="page-item-link @(Model.CurrentPage == 1 ? "disabled" : "")" 
                                            onclick="submitForm(@(Model.CurrentPage - 1))" aria-label="Previous page">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>
                                </li>
                                
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li>
                                        <button type="button" class="page-item-link @(Model.CurrentPage == i ? "active" : "")" 
                                                onclick="submitForm(@i)">
                                            @i
                                        </button>
                                    </li>
                                }
                                
                                <!-- Next page -->
                                <li>
                                    <button type="button" class="page-item-link @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" 
                                            onclick="submitForm(@(Model.CurrentPage + 1))" aria-label="Next page">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </main>
        </form>
    </div>

    <!-- Modal backdrop shell -->
    <div class="modal-backdrop" id="invoiceDetailModal">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Chi tiết hóa đơn</h3>
                <button type="button" class="modal-close-btn" id="closeModalBtn" aria-label="Close modal">&times;</button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- Inner details loaded via AJAX will populate here -->
            </div>
        </div>
    </div>

    <!-- Client-side Scripts -->
    <script>
        // Form submits with selected page
        function submitForm(page) {
            document.getElementById('pageNumberInput').value = page;
            document.getElementById('historyForm').submit();
        }

        // Reset all search criteria
        function resetFilters() {
            const form = document.getElementById('historyForm');
            
            // Clear inputs
            const quickSearch = document.getElementById('quickSearchInput');
            if (quickSearch) quickSearch.value = '';
            
            const customer = form.querySelector('input[name="customerFilter"]');
            if (customer) customer.value = '';
            
            const fromDate = form.querySelector('input[name="fromDate"]');
            if (fromDate) fromDate.value = '';
            
            const toDate = form.querySelector('input[name="toDate"]');
            if (toDate) toDate.value = '';
            
            const status = form.querySelector('select[name="status"]');
            if (status) status.selectedIndex = 0; // 'All'

            // Submit resetting to first page
            submitForm(1);
        }

        // AJAX loader for invoice details popup
        function viewInvoiceDetail(invoiceId) {
            const modalContent = document.getElementById('modalContent');
            modalContent.innerHTML = `
                <div style="text-align: center; padding: 40px; color: var(--text-secondary);">
                    <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 2rem; color: var(--primary-magenta); margin-bottom: 12px; display: block; margin-left: auto; margin-right: auto;"></i>
                    Đang tải chi tiết hóa đơn...
                </div>
            `;
            document.getElementById('invoiceDetailModal').classList.add('show');

            fetch(`/InvoiceHistory/GetInvoiceDetail?invoiceId=${invoiceId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Không thể tải chi tiết hóa đơn. Vui lòng thử lại.');
                    }
                    return response.text();
                })
                .then(html => {
                    modalContent.innerHTML = html;
                })
                .catch(error => {
                    modalContent.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: var(--color-danger);">
                            <i class="fa-solid fa-circle-exclamation" style="font-size: 2.5rem; margin-bottom: 12px; display: block; margin-left: auto; margin-right: auto;"></i>
                            <p>${error.message}</p>
                        </div>
                    `;
                });
        }

        // Modal opening/closing logic
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('invoiceDetailModal');
            const closeBtn = document.getElementById('closeModalBtn');

            function closeModal() {
                modal.classList.remove('show');
                // Give animation some time before wiping contents
                setTimeout(() => {
                    document.getElementById('modalContent').innerHTML = '';
                }, 300);
            }

            closeBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });

            // Handle ESC key to close modal
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modal.classList.contains('show')) {
                    closeModal();
                }
            });

            // Header quick search auto-submit after typing (debounce 800ms)
            const quickSearch = document.getElementById('quickSearchInput');
            let timeout = null;
            quickSearch.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => {
                    submitForm(1);
                }, 800);
            });

            // Focus quick search field if it has query text and place cursor at the end
            if (quickSearch.value) {
                quickSearch.focus();
                quickSearch.setSelectionRange(quickSearch.value.length, quickSearch.value.length);
            }
        });
    </script>
</body>
</html>
