@model List<KaraokeManagement.Models.Booking>
@{
    ViewData["Title"] = "Lịch sử đặt phòng";
    Layout = "~/Views/Customer/_CustomerLayout.cshtml";
    ViewData["ActiveNav"] = "bookings";
}

<div class="bookings-page">
    <!-- Page Header -->
    <div class="bookings-header">
        <div class="bookings-header-content">
            <h1><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử đặt phòng</h1>
            <p class="bookings-subtitle">Theo dõi tất cả các lượt đặt phòng karaoke của bạn</p>
        </div>
        <div class="bookings-stats">
            <div class="stat-pill">
                <i class="fa-solid fa-list-check"></i>
                <span>Tổng: <strong>@Model.Count</strong> lượt đặt</span>
            </div>
            @{
                var activeCount = Model.Count(b => b.Status == "CheckedIn");
                var completedCount = Model.Count(b => b.Status == "Completed");
            }
            @if (activeCount > 0)
            {
                <div class="stat-pill stat-active">
                    <i class="fa-solid fa-music"></i>
                    <span>Đang hát: <strong>@activeCount</strong></span>
                </div>
            }
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="bookings-filter-bar">
        <button class="filter-tab active" data-filter="all">
            <i class="fa-solid fa-border-all"></i> Tất cả
            <span class="filter-count">@Model.Count</span>
        </button>
        <button class="filter-tab" data-filter="CheckedIn">
            <i class="fa-solid fa-music"></i> Đang hát
            <span class="filter-count">@activeCount</span>
        </button>
        <button class="filter-tab" data-filter="Completed">
            <i class="fa-solid fa-circle-check"></i> Hoàn thành
            <span class="filter-count">@completedCount</span>
        </button>
        <button class="filter-tab" data-filter="Pending">
            <i class="fa-regular fa-clock"></i> Đặt trước
            <span class="filter-count">@Model.Count(b => b.Status == "Pending" || b.Status == "Confirmed")</span>
        </button>
        <button class="filter-tab" data-filter="Cancelled">
            <i class="fa-solid fa-ban"></i> Đã hủy
            <span class="filter-count">@Model.Count(b => b.Status == "Cancelled")</span>
        </button>
    </div>

    <!-- Bookings List -->
    @if (Model.Count == 0)
    {
        <div class="bookings-empty">
            <i class="fa-solid fa-folder-open"></i>
            <h3>Chưa có lượt đặt phòng nào</h3>
            <p>Hãy bắt đầu trải nghiệm karaoke tuyệt vời cùng chúng tôi!</p>
            <a href="/Customer/Rooms" class="btn-book-now">
                <i class="fa-solid fa-music"></i> Đặt phòng ngay
            </a>
        </div>
    }
    else
    {
        <div class="bookings-list" id="bookingsList">
            @foreach (var booking in Model)
            {
                var statusClass = booking.Status switch
                {
                    "CheckedIn" => "status-active",
                    "Completed" => "status-completed",
                    "Cancelled" => "status-cancelled",
                    "Pending" => "status-pending",
                    "Confirmed" => "status-pending",
                    _ => "status-default"
                };
                var statusIcon = booking.Status switch
                {
                    "CheckedIn" => "fa-solid fa-music",
                    "Completed" => "fa-solid fa-circle-check",
                    "Cancelled" => "fa-solid fa-ban",
                    "Pending" => "fa-regular fa-clock",
                    "Confirmed" => "fa-solid fa-calendar-check",
                    _ => "fa-solid fa-circle-info"
                };
                var statusText = booking.Status switch
                {
                    "CheckedIn" => "Đang hát",
                    "Completed" => "Hoàn thành",
                    "Cancelled" => "Đã hủy",
                    "Pending" => "Đặt trước",
                    "Confirmed" => "Đã xác nhận",
                    _ => booking.Status ?? "Không rõ"
                };
                var filterGroup = booking.Status switch
                {
                    "Pending" => "Pending",
                    "Confirmed" => "Pending",
                    _ => booking.Status ?? ""
                };
                var invoice = booking.Invoices?.FirstOrDefault();

                <a href="/Customer/BookingDetail?id=@booking.BookingId" class="booking-card-link" data-status="@filterGroup">
                    <div class="booking-card @(booking.Status == "CheckedIn" ? "booking-card-active" : "")">
                        <!-- Status ribbon -->
                        <div class="booking-status-ribbon @statusClass">
                            <i class="@statusIcon"></i>
                            <span>@statusText</span>
                        </div>

                        <div class="booking-card-body">
                            <!-- Room Info -->
                            <div class="booking-room-info">
                                <div class="booking-room-icon">
                                    <i class="fa-solid fa-door-open"></i>
                                </div>
                                <div class="booking-room-text">
                                    <h3 class="booking-room-name">@booking.Room?.RoomName</h3>
                                    <span class="booking-room-type">@booking.Room?.RoomType?.TypeName</span>
                                </div>
                            </div>

                            <!-- Booking Details Row -->
                            <div class="booking-details-row">
                                <div class="booking-detail-item">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span>@booking.StartTime.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="booking-detail-item">
                                    <i class="fa-regular fa-clock"></i>
                                    <span>@booking.StartTime.ToString("HH:mm") - @(booking.EndTime?.ToString("HH:mm") ?? "...")</span>
                                </div>
                                @if (booking.GuestCount.HasValue && booking.GuestCount > 0)
                                {
                                    <div class="booking-detail-item">
                                        <i class="fa-solid fa-users"></i>
                                        <span>@booking.GuestCount người</span>
                                    </div>
                                }
                            </div>

                            <!-- Footer: Price + Arrow -->
                            <div class="booking-card-footer">
                                @if (invoice != null && invoice.GrandTotal.HasValue)
                                {
                                    <div class="booking-total-price">
                                        <span class="price-label">Tổng tiền</span>
                                        <span class="price-value">@invoice.GrandTotal.Value.ToString("N0")₫</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="booking-total-price">
                                        <span class="price-label">Tổng tiền</span>
                                        <span class="price-value price-pending">Chưa thanh toán</span>
                                    </div>
                                }
                                <div class="booking-arrow">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<style>
    /* ===== BOOKINGS PAGE ===== */
    .bookings-page {
        max-width: 900px;
        margin: 30px auto 60px;
        padding: 0 20px;
    }

    .bookings-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .bookings-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: var(--dark-purple);
        margin: 0;
    }
    .bookings-header h1 i {
        color: var(--pink-bold);
        margin-right: 10px;
    }
    .bookings-subtitle {
        color: #8c7f99;
        font-size: 15px;
        margin-top: 6px;
    }

    .bookings-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #f3f0f7;
        color: var(--dark-purple);
        font-size: 13px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 30px;
    }
    .stat-pill i { color: var(--pink-bold); }
    .stat-pill strong { font-weight: 700; }
    .stat-active {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        color: #2e7d32;
    }
    .stat-active i { color: #2e7d32; }

    /* Filter Bar */
    .bookings-filter-bar {
        display: flex;
        gap: 6px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding-bottom: 4px;
    }
    .bookings-filter-bar::-webkit-scrollbar { height: 0; }

    .filter-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border: 2px solid #e8e3ee;
        border-radius: 30px;
        background: #fff;
        color: #7a6e87;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s ease;
        white-space: nowrap;
        font-family: 'Inter', sans-serif;
    }
    .filter-tab:hover {
        border-color: var(--pink-soft);
        color: var(--pink-bold);
        background: #fff5f8;
    }
    .filter-tab.active {
        border-color: var(--pink-bold);
        color: #fff;
        background: var(--pink-bold);
    }
    .filter-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 12px;
        background: rgba(0,0,0,0.08);
        font-size: 11px;
        font-weight: 700;
    }
    .filter-tab.active .filter-count {
        background: rgba(255,255,255,0.25);
    }

    /* Empty State */
    .bookings-empty {
        text-align: center;
        padding: 80px 20px;
        color: #8c7f99;
    }
    .bookings-empty i {
        font-size: 64px;
        color: #d6cee0;
        margin-bottom: 20px;
    }
    .bookings-empty h3 {
        font-size: 20px;
        color: var(--dark-purple);
        margin-bottom: 10px;
    }
    .bookings-empty p {
        font-size: 15px;
        margin-bottom: 24px;
    }
    .btn-book-now {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--pink-bold);
        color: #fff;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .btn-book-now:hover {
        background: var(--dark-purple);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(67,51,76,0.25);
    }

    /* Booking Card */
    .booking-card-link {
        text-decoration: none;
        display: block;
        margin-bottom: 16px;
    }

    .booking-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #ece7f2;
        overflow: hidden;
        transition: all 0.3s ease;
        position: relative;
    }
    .booking-card:hover {
        border-color: var(--pink-soft);
        box-shadow: 0 8px 30px rgba(232, 60, 145, 0.12);
        transform: translateY(-3px);
    }
    .booking-card-active {
        border-color: #66bb6a;
        box-shadow: 0 0 0 2px rgba(102, 187, 106, 0.15);
    }
    .booking-card-active:hover {
        border-color: #43a047;
        box-shadow: 0 8px 30px rgba(76, 175, 80, 0.18);
    }

    /* Status Ribbon */
    .booking-status-ribbon {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.3px;
        border-bottom-right-radius: 12px;
    }
    .status-active {
        background: linear-gradient(135deg, #43a047, #66bb6a);
        color: #fff;
    }
    .status-completed {
        background: linear-gradient(135deg, #5c6bc0, #7986cb);
        color: #fff;
    }
    .status-cancelled {
        background: linear-gradient(135deg, #e53935, #ef5350);
        color: #fff;
    }
    .status-pending {
        background: linear-gradient(135deg, #fb8c00, #ffa726);
        color: #fff;
    }
    .status-default {
        background: #9e9e9e;
        color: #fff;
    }

    /* Card Body */
    .booking-card-body {
        padding: 20px 24px;
    }

    .booking-room-info {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }
    .booking-room-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #fce4ec, #f8bbd0);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .booking-room-icon i {
        font-size: 20px;
        color: var(--pink-bold);
    }
    .booking-card-active .booking-room-icon {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    }
    .booking-card-active .booking-room-icon i {
        color: #2e7d32;
    }
    .booking-room-name {
        font-size: 17px;
        font-weight: 700;
        color: var(--dark-purple);
        margin: 0 0 3px;
    }
    .booking-room-type {
        font-size: 13px;
        color: #9c8faa;
        font-weight: 500;
    }

    /* Detail Items Row */
    .booking-details-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px dashed #ece7f2;
    }
    .booking-detail-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: #6b5f7a;
        font-weight: 500;
    }
    .booking-detail-item i {
        color: var(--pink-bold);
        font-size: 14px;
        width: 16px;
        text-align: center;
    }

    /* Card Footer */
    .booking-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .price-label {
        font-size: 12px;
        color: #9c8faa;
        display: block;
        margin-bottom: 2px;
        font-weight: 500;
    }
    .price-value {
        font-size: 18px;
        font-weight: 800;
        color: var(--pink-bold);
    }
    .price-pending {
        font-size: 14px;
        font-weight: 600;
        color: #9c8faa;
    }
    .booking-arrow {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f5f1fa;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    .booking-arrow i {
        color: var(--pink-bold);
        font-size: 14px;
    }
    .booking-card:hover .booking-arrow {
        background: var(--pink-bold);
    }
    .booking-card:hover .booking-arrow i {
        color: #fff;
    }
</style>

@section Scripts {
<script>
    // Filter Tabs Logic
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');

            const filter = this.getAttribute('data-filter');
            document.querySelectorAll('.booking-card-link').forEach(card => {
                if (filter === 'all') {
                    card.style.display = 'block';
                } else {
                    card.style.display = card.getAttribute('data-status') === filter ? 'block' : 'none';
                }
            });
        });
    });
</script>
}
