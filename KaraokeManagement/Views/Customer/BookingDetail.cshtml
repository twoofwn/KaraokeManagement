@section Scripts {
<script>
    function toggleCustomerCancellationDetail() {
        var select = document.getElementById('customerCancellationReasonId');
        var option = select.options[select.selectedIndex];
        var requiresDetail = option && option.dataset.requiresDetail === 'true';
        var group = document.getElementById('customerCancellationDetailGroup');
        var detail = document.getElementById('customerCancellationReasonDetail');
        group.hidden = !requiresDetail;
        detail.required = requiresDetail;
        if (!requiresDetail) detail.value = '';
    }

    // Character count for report textarea
    var reportMsg = document.getElementById('reportMessage');
    var charCount = document.getElementById('charCount');
    if (reportMsg && charCount) {
        reportMsg.addEventListener('input', function () {
            charCount.textContent = this.value.length;
        });
    }

    // Star Rating Picker
    var starPicker = document.getElementById('starPicker');
    var ratingInput = document.getElementById('ratingInput');
    var starText = document.getElementById('starText');
    var btnSubmit = document.getElementById('btnReviewSubmit');

    if (starPicker) {
        var stars = starPicker.querySelectorAll('.star-pick');
        var currentRating = 0;
        var ratingLabels = ['', 'Rất tệ 😞', 'Tệ 😕', 'Bình thường 😐', 'Tốt 😊', 'Tuyệt vời 🤩'];

        stars.forEach(function (star) {
            star.addEventListener('mouseenter', function () {
                var val = parseInt(this.getAttribute('data-value'));
                highlightStars(val);
                starText.textContent = ratingLabels[val];
            });

            star.addEventListener('mouseleave', function () {
                highlightStars(currentRating);
                starText.textContent = currentRating > 0 ? ratingLabels[currentRating] : 'Chưa chọn';
            });

            star.addEventListener('click', function () {
                currentRating = parseInt(this.getAttribute('data-value'));
                ratingInput.value = currentRating;
                highlightStars(currentRating);
                starText.textContent = ratingLabels[currentRating];
                if (btnSubmit) btnSubmit.disabled = false;
            });
        });

        function highlightStars(count) {
            stars.forEach(function (s) {
                var v = parseInt(s.getAttribute('data-value'));
                if (v <= count) {
                    s.classList.remove('fa-regular');
                    s.classList.add('fa-solid', 'selected');
                } else {
                    s.classList.remove('fa-solid', 'selected');
                    s.classList.add('fa-regular');
                }
            });
        }
    }
</script>
}
