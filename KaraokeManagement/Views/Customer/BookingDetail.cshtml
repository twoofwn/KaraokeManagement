@model KaraokeManagement.Models.Booking
@{
    ViewData["Title"] = "Chi tiết đặt phòng #" + Model.BookingId;
    Layout = "~/Views/Customer/_CustomerLayout.cshtml";
    ViewData["ActiveNav"] = "bookings";

    var invoice = ViewBag.Invoice as KaraokeManagement.Models.Invoice;
    var existingReview = ViewBag.ExistingReview as KaraokeManagement.Models.CustomerReview;
    var reports = ViewBag.Reports as List<KaraokeManagement.Models.NotificationLog> ?? new List<KaraokeManagement.Models.NotificationLog>();
    var cancellationReasons = ViewBag.CancellationReasons as List<KaraokeManagement.Models.CancellationReason>
        ?? new List<KaraokeManagement.Models.CancellationReason>();

    var statusClass = Model.Status switch
    {
        "CheckedIn" => "detail-status-active",
        "Completed" => "detail-status-completed",
        "Cancelled" => "detail-status-cancelled",
        "Pending" => "detail-status-pending",
        "Confirmed" => "detail-status-pending",
        _ => "detail-status-default"
    };
    var statusText = Model.Status switch
    {
        "CheckedIn" => "Đang hát",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        "Pending" => "Đặt trước",
        "Confirmed" => "Đã xác nhận",
        _ => Model.Status ?? "Không rõ"
    };
    var statusIcon = Model.Status switch
    {
        "CheckedIn" => "fa-solid fa-music",
        "Completed" => "fa-solid fa-circle-check",
        "Cancelled" => "fa-solid fa-ban",
        "Pending" => "fa-regular fa-clock",
        "Confirmed" => "fa-solid fa-calendar-check",
        _ => "fa-solid fa-circle-info"
    };
}

<div class="detail-page">
    <!-- Back Button -->
    <a href="/Customer/Bookings" class="detail-back-btn">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Quay lại danh sách</span>
    </a>

    <!-- Top Card: Booking Overview -->
    <div class="detail-overview-card">
        <div class="detail-overview-header">
            <div class="detail-overview-left">
                <div class="detail-room-icon-box @(Model.Status == "CheckedIn" ? "icon-active" : "")">
                    <i class="fa-solid fa-door-open"></i>
                </div>
                <div>
                    <h1 class="detail-room-name">@Model.Room?.RoomName</h1>
                    <span class="detail-room-type">@Model.Room?.RoomType?.TypeName • Sức chứa @(Model.Room?.RoomType?.Capacity ?? 0) người</span>
                </div>
            </div>
            <div class="detail-status-badge @statusClass">
                <i class="@statusIcon"></i>
                <span>@statusText</span>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="detail-info-grid">
            <div class="detail-info-cell">
                <div class="info-cell-icon"><i class="fa-solid fa-hashtag"></i></div>
                <div class="info-cell-text">
                    <span class="info-label">Mã đặt phòng</span>
                    <span class="info-value">#@Model.BookingId</span>
                </div>
            </div>
            <div class="detail-info-cell">
                <div class="info-cell-icon"><i class="fa-regular fa-calendar"></i></div>
                <div class="info-cell-text">
                    <span class="info-label">Ngày hát</span>
                    <span class="info-value">@Model.StartTime.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
            <div class="detail-info-cell">
                <div class="info-cell-icon"><i class="fa-regular fa-clock"></i></div>
                <div class="info-cell-text">
                    <span class="info-label">Giờ bắt đầu</span>
                    <span class="info-value">@Model.StartTime.ToString("HH:mm")</span>
                </div>
            </div>
            <div class="detail-info-cell">
                <div class="info-cell-icon"><i class="fa-solid fa-flag-checkered"></i></div>
                <div class="info-cell-text">
                    <span class="info-label">Giờ kết thúc</span>
                    <span class="info-value">@(Model.EndTime?.ToString("HH:mm") ?? "—")</span>
                </div>
            </div>
            @if (Model.GuestCount.HasValue && Model.GuestCount > 0)
            {
                <div class="detail-info-cell">
                    <div class="info-cell-icon"><i class="fa-solid fa-users"></i></div>
                    <div class="info-cell-text">
                        <span class="info-label">Số khách</span>
                        <span class="info-value">@Model.GuestCount người</span>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="detail-info-cell" style="grid-column: span 2;">
                    <div class="info-cell-icon"><i class="fa-solid fa-sticky-note"></i></div>
                    <div class="info-cell-text">
                        <span class="info-label">Ghi chú</span>
                        <span class="info-value">@Model.Note</span>
                    </div>
                </div>
            }
            @if (Model.Status == "Cancelled" && Model.CancellationReason != null)
            {
                <div class="detail-info-cell" style="grid-column: span 2;">
                    <div class="info-cell-icon"><i class="fa-solid fa-ban"></i></div>
                    <div class="info-cell-text">
                        <span class="info-label">Lý do hủy</span>
                        <span class="info-value">
                            @(Model.CancellationReason.RequiresDetail
                                ? Model.CancellationReasonDetail
                                : Model.CancellationReason.ReasonName)
                        </span>
                        @if (Model.CancelledAt.HasValue)
                        {
                            <small>Hủy lúc @Model.CancelledAt.Value.ToString("HH:mm dd/MM/yyyy")</small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (TempData["CancellationSuccess"] != null)
    {
        <div class="alert-box alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["CancellationSuccess"]</span>
        </div>
    }
    @if (TempData["CancellationError"] != null)
    {
        <div class="alert-box alert-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["CancellationError"]</span>
        </div>
    }

    @if ((Model.Status == "Pending" || Model.Status == "Confirmed") && Model.StartTime > DateTime.Now)
    {
        <div class="booking-cancel-actions">
            <button type="button" class="btn-cancel-customer" onclick="document.getElementById('customerCancellationDialog').showModal()">
                <i class="fa-solid fa-ban"></i> Hủy đặt phòng
            </button>
        </div>
    }

    <!-- Invoice Section (if exists) -->
    @if (invoice != null)
    {
        <div class="detail-section-card">
            <div class="detail-section-header">
                <h2><i class="fa-solid fa-file-invoice-dollar"></i> Hóa đơn thanh toán</h2>
                <span class="invoice-id">#@invoice.InvoiceId</span>
            </div>

            <!-- Invoice Details Table -->
            @if (invoice.InvoiceDetails != null && invoice.InvoiceDetails.Any())
            {
                <div class="invoice-table-wrap">
                    <table class="invoice-table">
                        <thead>
                            <tr>
                                <th>Dịch vụ</th>
                                <th style="text-align:center;">SL</th>
                                <th style="text-align:right;">Đơn giá</th>
                                <th style="text-align:right;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in invoice.InvoiceDetails)
                            {
                                <tr>
                                    <td>@detail.Service?.ServiceName</td>
                                    <td style="text-align:center;">@detail.Quantity</td>
                                    <td style="text-align:right;">@detail.UnitPrice.ToString("N0")₫</td>
                                    <td style="text-align:right;">@((detail.Quantity * detail.UnitPrice).ToString("N0"))₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Invoice Summary -->
            <div class="invoice-summary">
                <div class="invoice-summary-row">
                    <span>Tiền phòng</span>
                    <span>@(invoice.RoomTotal?.ToString("N0") ?? "0")₫</span>
                </div>
                @if (invoice.ServiceTotal.HasValue && invoice.ServiceTotal > 0)
                {
                    <div class="invoice-summary-row">
                        <span>Tiền dịch vụ</span>
                        <span>@invoice.ServiceTotal.Value.ToString("N0")₫</span>
                    </div>
                }
                @if (invoice.DiscountAmount.HasValue && invoice.DiscountAmount > 0)
                {
                    <div class="invoice-summary-row discount-row">
                        <span><i class="fa-solid fa-tag"></i> Giảm giá</span>
                        <span>-@invoice.DiscountAmount.Value.ToString("N0")₫</span>
                    </div>
                }
                <div class="invoice-summary-row total-row">
                    <span>Tổng cộng</span>
                    <span>@(invoice.GrandTotal?.ToString("N0") ?? "0")₫</span>
                </div>
            </div>
        </div>
    }

    <!-- ===== ACTIVE BOOKING: REPORT SECTION ===== -->
    @if (Model.Status == "CheckedIn")
    {
        <div class="detail-section-card report-section">
            <div class="detail-section-header">
                <h2><i class="fa-solid fa-triangle-exclamation"></i> Báo cáo sự cố phòng hát</h2>
            </div>
            <p class="report-desc">
                Bạn đang sử dụng phòng? Nếu gặp bất kỳ sự cố nào (thiết bị hỏng, nước đá hết, yêu cầu hỗ trợ...),
                hãy gửi báo cáo bên dưới. Nhân viên sẽ xử lý <strong>ngay lập tức</strong>!
            </p>

            @if (TempData["ReportSuccess"] != null)
            {
                <div class="alert-box alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>@TempData["ReportSuccess"]</span>
                </div>
            }
            @if (TempData["ReportError"] != null)
            {
                <div class="alert-box alert-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@TempData["ReportError"]</span>
                </div>
            }

            <form method="post" action="/Customer/SendBookingReport" class="report-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                <div class="report-textarea-wrap">
                    <textarea name="message" id="reportMessage" rows="3" placeholder="Mô tả sự cố bạn gặp phải... (VD: Micro phòng bị rè, đèn nháy hỏng, yêu cầu thêm đá lạnh...)" maxlength="500" required></textarea>
                    <span class="char-count"><span id="charCount">0</span>/500</span>
                </div>
                <button type="submit" class="btn-report-submit">
                    <i class="fa-solid fa-paper-plane"></i> Gửi báo cáo
                </button>
            </form>

            <!-- Previous Reports -->
            @if (reports.Any())
            {
                <div class="previous-reports">
                    <h4><i class="fa-solid fa-list"></i> Báo cáo đã gửi (@reports.Count)</h4>
                    @foreach (var report in reports)
                    {
                        <div class="report-item">
                            <div class="report-item-header">
                                <span class="report-time"><i class="fa-regular fa-clock"></i> @report.SentAt?.ToString("HH:mm dd/MM/yyyy")</span>
                                <span class="report-status-sent"><i class="fa-solid fa-check-double"></i> Đã gửi</span>
                            </div>
                            <p class="report-content">@report.MessageContent</p>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ===== COMPLETED BOOKING: REVIEW SECTION ===== -->
    @if (Model.Status == "Completed")
    {
        <div class="detail-section-card review-section">
            <div class="detail-section-header">
                <h2><i class="fa-solid fa-star"></i> Đánh giá chất lượng dịch vụ</h2>
            </div>

            @if (existingReview != null)
            {
                <!-- Show existing review -->
                <div class="existing-review">
                    <div class="review-stars-display">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= existingReview.Rating)
                            {
                                <i class="fa-solid fa-star star-filled"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star star-empty"></i>
                            }
                        }
                        <span class="review-rating-text">@existingReview.Rating/5</span>
                    </div>
                    @if (!string.IsNullOrEmpty(existingReview.Comment))
                    {
                        <div class="review-comment-display">
                            <i class="fa-solid fa-quote-left"></i>
                            <p>@existingReview.Comment</p>
                        </div>
                    }
                    <p class="review-date"><i class="fa-regular fa-clock"></i> Đánh giá lúc @existingReview.CreatedAt?.ToString("HH:mm dd/MM/yyyy")</p>
                    <div class="review-thank-you">
                        <i class="fa-solid fa-heart"></i>
                        <span>Cảm ơn bạn đã đánh giá! Phản hồi của bạn rất quý giá đối với chúng tôi.</span>
                    </div>
                </div>
            }
            else if (invoice != null)
            {
                <!-- Review Form -->
                <p class="review-desc">
                    Trải nghiệm hát karaoke của bạn như thế nào? Hãy cho chúng tôi biết ý kiến của bạn!
                </p>

                @if (TempData["ReviewSuccess"] != null)
                {
                    <div class="alert-box alert-success">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>@TempData["ReviewSuccess"]</span>
                    </div>
                }
                @if (TempData["ReviewError"] != null)
                {
                    <div class="alert-box alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@TempData["ReviewError"]</span>
                    </div>
                }

                <form method="post" action="/Customer/SubmitReview" class="review-form" id="reviewForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="invoiceId" value="@invoice.InvoiceId" />
                    <input type="hidden" name="rating" id="ratingInput" value="0" />

                    <div class="star-rating-input">
                        <label class="star-rating-label">Chất lượng dịch vụ:</label>
                        <div class="star-picker" id="starPicker">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa-regular fa-star star-pick" data-value="@i" title="@i sao"></i>
                            }
                        </div>
                        <span class="star-text" id="starText">Chưa chọn</span>
                    </div>

                    <div class="review-textarea-wrap">
                        <textarea name="comment" rows="3" placeholder="Chia sẻ cảm nhận của bạn về phòng hát, âm thanh, nhân viên phục vụ... (tùy chọn)" maxlength="500"></textarea>
                    </div>

                    <button type="submit" class="btn-review-submit" id="btnReviewSubmit" disabled>
                        <i class="fa-solid fa-paper-plane"></i> Gửi đánh giá
                    </button>
                </form>
            }
            else
            {
                <div class="review-no-invoice">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <p>Hóa đơn đang được xử lý. Bạn có thể đánh giá sau khi hóa đơn hoàn tất.</p>
                </div>
            }
        </div>
    }
</div>

<dialog id="customerCancellationDialog" class="customer-cancellation-dialog">
    <form method="post" action="/Customer/CancelBooking">
        @Html.AntiForgeryToken()
        <input type="hidden" name="bookingId" value="@Model.BookingId" />

        <div class="cancel-dialog-header">
            <div>
                <h3>Hủy đặt phòng</h3>
                <p>Đơn #BK-@Model.BookingId.ToString("D4")</p>
            </div>
            <button type="button" onclick="document.getElementById('customerCancellationDialog').close()" aria-label="Đóng">&times;</button>
        </div>

        <div class="cancel-dialog-body">
            <label for="customerCancellationReasonId">Lý do hủy <span>*</span></label>
            <select name="cancellationReasonId" id="customerCancellationReasonId"
                    onchange="toggleCustomerCancellationDetail()" required>
                <option value="">-- Chọn lý do hủy --</option>
                @foreach (var reason in cancellationReasons)
                {
                    <option value="@reason.CancellationReasonId"
                            data-requires-detail="@reason.RequiresDetail.ToString().ToLowerInvariant()">
                        @reason.ReasonName
                    </option>
                }
            </select>

            <div id="customerCancellationDetailGroup" hidden>
                <label for="customerCancellationReasonDetail">Lý do cụ thể <span>*</span></label>
                <textarea name="cancellationReasonDetail" id="customerCancellationReasonDetail"
                          maxlength="500" rows="4" placeholder="Nhập lý do hủy phòng..."></textarea>
                <small>Tối đa 500 ký tự.</small>
            </div>
        </div>

        <div class="cancel-dialog-actions">
            <button type="button" class="btn-cancel-back" onclick="document.getElementById('customerCancellationDialog').close()">Quay lại</button>
            <button type="submit" class="btn-cancel-confirm">
                <i class="fa-solid fa-ban"></i> Xác nhận hủy
            </button>
        </div>
    </form>
</dialog>

<style>
    .booking-cancel-actions {
        display: flex;
        justify-content: flex-end;
        margin: -4px 0 24px;
    }
    .btn-cancel-customer {
        border: 1px solid #d32f2f;
        background: #fff;
        color: #c62828;
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
        cursor: pointer;
    }
    .btn-cancel-customer:hover {
        background: #ffebee;
    }
    .customer-cancellation-dialog {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        width: min(520px, calc(100vw - 32px));
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        border: 0;
        border-radius: 18px;
        padding: 0;
        box-shadow: 0 24px 70px rgba(31, 21, 46, .25);
        color: #2b2036;
    }
    .customer-cancellation-dialog::backdrop {
        background: rgba(20, 12, 28, .55);
        backdrop-filter: blur(2px);
    }
    .cancel-dialog-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 22px 24px;
        border-bottom: 1px solid #eee7f1;
    }
    .cancel-dialog-header h3 { margin: 0; font-size: 1.2rem; }
    .cancel-dialog-header p { margin: 5px 0 0; color: #7d7185; font-size: .85rem; }
    .cancel-dialog-header button { border: 0; background: transparent; font-size: 1.7rem; line-height: 1; cursor: pointer; color: #74677c; }
    .cancel-dialog-body { display: grid; gap: 10px; padding: 22px 24px; }
    .cancel-dialog-body label { font-weight: 700; margin-top: 4px; }
    .cancel-dialog-body label span { color: #c62828; }
    .cancel-dialog-body select, .cancel-dialog-body textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #d9cfde;
        border-radius: 10px;
        padding: 11px 12px;
        font: inherit;
        background: white;
    }
    .cancel-dialog-body small { color: #7d7185; }
    .cancel-dialog-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px 22px; }
    .btn-cancel-back, .btn-cancel-confirm { border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; }
    .btn-cancel-back { background: #eee9f1; color: #493d50; }
    .btn-cancel-confirm { background: #c62828; color: white; }

    /* ===== DETAIL PAGE ===== */
    .detail-page {
        max-width: 850px;
        margin: 30px auto 60px;
        padding: 0 20px;
    }

    /* Back Button */
    .detail-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #7a6e87;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 24px;
        padding: 8px 16px;
        border-radius: 10px;
        background: #f5f1fa;
        transition: all 0.25s ease;
    }
    .detail-back-btn:hover {
        background: var(--pink-bold);
        color: #fff;
    }

    /* Overview Card */
    .detail-overview-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #ece7f2;
        padding: 28px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(67, 51, 76, 0.06);
    }
    .detail-overview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .detail-overview-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .detail-room-icon-box {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #fce4ec, #f8bbd0);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .detail-room-icon-box i {
        font-size: 24px;
        color: var(--pink-bold);
    }
    .detail-room-icon-box.icon-active {
        background: linear-gradient(135deg, #e8f5e9, #a5d6a7);
    }
    .detail-room-icon-box.icon-active i {
        color: #2e7d32;
    }
    .detail-room-name {
        font-size: 24px;
        font-weight: 800;
        color: var(--dark-purple);
        margin: 0 0 4px;
    }
    .detail-room-type {
        font-size: 14px;
        color: #9c8faa;
        font-weight: 500;
    }

    /* Status Badge */
    .detail-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }
    .detail-status-active {
        background: linear-gradient(135deg, #43a047, #66bb6a);
        color: #fff;
        box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
        animation: pulse-green 2s ease-in-out infinite;
    }
    .detail-status-completed {
        background: linear-gradient(135deg, #5c6bc0, #7986cb);
        color: #fff;
        box-shadow: 0 4px 15px rgba(92, 107, 192, 0.3);
    }
    .detail-status-cancelled {
        background: linear-gradient(135deg, #e53935, #ef5350);
        color: #fff;
    }
    .detail-status-pending {
        background: linear-gradient(135deg, #fb8c00, #ffa726);
        color: #fff;
    }
    .detail-status-default {
        background: #9e9e9e;
        color: #fff;
    }

    /* Info Grid */
    .detail-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    .detail-info-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: #faf8fd;
        border-radius: 12px;
        border: 1px solid #f0ecf5;
    }
    .info-cell-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #f3e5f5, #e1bee7);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .info-cell-icon i {
        font-size: 14px;
        color: var(--pink-bold);
    }
    .info-label {
